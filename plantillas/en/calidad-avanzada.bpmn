    </bpmn:laneSet>
    <bpmn:startEvent id="calidad_avanzada_p_ini" name="Audit is scheduled">
      <bpmn:outgoing>calidad_avanzada_f1_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="calidad_avanzada_p_par">
      <bpmn:incoming>calidad_avanzada_f1_0</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f1_1</bpmn:outgoing>
      <bpmn:outgoing>calidad_avanzada_f1_2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="calidad_avanzada_p_doc" name="Update procedures and records">
      <bpmn:incoming>calidad_avanzada_f1_1</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f1_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="calidad_avanzada_p_aut" name="Run a self-assessment">
      <bpmn:incoming>calidad_avanzada_f1_2</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f1_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="calidad_avanzada_p_jun">
      <bpmn:incoming>calidad_avanzada_f1_3</bpmn:incoming>
      <bpmn:incoming>calidad_avanzada_f1_4</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f1_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="calidad_avanzada_p_dec" name="Everything ready?">
      <bpmn:incoming>calidad_avanzada_f1_5</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f1_6</bpmn:outgoing>
      <bpmn:outgoing>calidad_avanzada_f1_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="calidad_avanzada_p_ok" name="Ready for the audit">
      <bpmn:incoming>calidad_avanzada_f1_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="calidad_avanzada_p_com" name="Complete what is pending">
      <bpmn:incoming>calidad_avanzada_f1_7</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f1_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="calidad_avanzada_p_fi2" name="Ready with minor pending items">
      <bpmn:incoming>calidad_avanzada_f1_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="calidad_avanzada_f1_0" sourceRef="calidad_avanzada_p_ini" targetRef="calidad_avanzada_p_par" />
    <bpmn:sequenceFlow id="calidad_avanzada_f1_1" sourceRef="calidad_avanzada_p_par" targetRef="calidad_avanzada_p_doc" />
    <bpmn:sequenceFlow id="calidad_avanzada_f1_2" sourceRef="calidad_avanzada_p_par" targetRef="calidad_avanzada_p_aut" />
    <bpmn:sequenceFlow id="calidad_avanzada_f1_3" sourceRef="calidad_avanzada_p_doc" targetRef="calidad_avanzada_p_jun" />
    <bpmn:sequenceFlow id="calidad_avanzada_f1_4" sourceRef="calidad_avanzada_p_aut" targetRef="calidad_avanzada_p_jun" />
    <bpmn:sequenceFlow id="calidad_avanzada_f1_5" sourceRef="calidad_avanzada_p_jun" targetRef="calidad_avanzada_p_dec" />
    <bpmn:sequenceFlow id="calidad_avanzada_f1_6" name="Yes" sourceRef="calidad_avanzada_p_dec" targetRef="calidad_avanzada_p_ok" />
    <bpmn:sequenceFlow id="calidad_avanzada_f1_7" name="No" sourceRef="calidad_avanzada_p_dec" targetRef="calidad_avanzada_p_com" />
    <bpmn:sequenceFlow id="calidad_avanzada_f1_8" sourceRef="calidad_avanzada_p_com" targetRef="calidad_avanzada_p_fi2" />
  </bpmn:process>
