<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="calidad_avanzada_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="calidad_avanzada_colab0">
    <bpmn:participant id="calidad_avanzada_pool_empresa" name="Company" processRef="calidad_avanzada_proceso_empresa" />
    <bpmn:participant id="calidad_avanzada_pool_auditora" name="Auditing firm" processRef="calidad_avanzada_proceso_auditora" />
    <bpmn:messageFlow id="calidad_avanzada_m0_0" name="Request" sourceRef="calidad_avanzada_e_sol" targetRef="calidad_avanzada_a_ini" />
    <bpmn:messageFlow id="calidad_avanzada_m0_1" name="Report" sourceRef="calidad_avanzada_a_inf" targetRef="calidad_avanzada_e_inf" />
    <bpmn:messageFlow id="calidad_avanzada_m0_2" name="Certificate" sourceRef="calidad_avanzada_a_cer" targetRef="calidad_avanzada_e_cer" />
  </bpmn:collaboration>
  <bpmn:process id="calidad_avanzada_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="calidad_avanzada_carriles_empresa">
      <bpmn:lane id="calidad_avanzada_carril_cal" name="Quality">
        <bpmn:flowNodeRef>calidad_avanzada_e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_e_sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_e_pre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_e_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_e_inf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_e_hal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_e_uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_e_cer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="calidad_avanzada_carril_are" name="Audited areas">
        <bpmn:flowNodeRef>calidad_avanzada_e_atn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_e_cor</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="calidad_avanzada_e_ini" name="Annual audit approaches">
      <bpmn:outgoing>calidad_avanzada_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="calidad_avanzada_e_sol" name="Request the audit">
      <bpmn:incoming>calidad_avanzada_f0_0</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="calidad_avanzada_e_pre" name="Prepare for the audit">
      <bpmn:documentation>The details are in the "Prepare for the audit" tab.</bpmn:documentation>
      <bpmn:incoming>calidad_avanzada_f0_1</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="calidad_avanzada_e_esp" name="Wait for the audit date">
      <bpmn:incoming>calidad_avanzada_f0_2</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="calidad_avanzada_e_esp_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="calidad_avanzada_e_atn" name="Host the auditors">
      <bpmn:incoming>calidad_avanzada_f0_3</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="calidad_avanzada_e_inf" name="Audit report arrives">
      <bpmn:incoming>calidad_avanzada_f0_4</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="calidad_avanzada_e_inf_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="calidad_avanzada_e_hal" name="Any findings?">
      <bpmn:incoming>calidad_avanzada_f0_5</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_6</bpmn:outgoing>
      <bpmn:outgoing>calidad_avanzada_f0_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="calidad_avanzada_e_cor" name="Correct the findings">
      <bpmn:incoming>calidad_avanzada_f0_7</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="calidad_avanzada_e_uni">
      <bpmn:incoming>calidad_avanzada_f0_6</bpmn:incoming>
      <bpmn:incoming>calidad_avanzada_f0_8</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="calidad_avanzada_e_cer" name="Certificate arrives">
      <bpmn:incoming>calidad_avanzada_f0_9</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="calidad_avanzada_e_cer_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="calidad_avanzada_e_fin" name="Company certified">
      <bpmn:incoming>calidad_avanzada_f0_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="calidad_avanzada_f0_0" sourceRef="calidad_avanzada_e_ini" targetRef="calidad_avanzada_e_sol" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_1" sourceRef="calidad_avanzada_e_sol" targetRef="calidad_avanzada_e_pre" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_2" sourceRef="calidad_avanzada_e_pre" targetRef="calidad_avanzada_e_esp" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_3" sourceRef="calidad_avanzada_e_esp" targetRef="calidad_avanzada_e_atn" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_4" sourceRef="calidad_avanzada_e_atn" targetRef="calidad_avanzada_e_inf" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_5" sourceRef="calidad_avanzada_e_inf" targetRef="calidad_avanzada_e_hal" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_6" name="No" sourceRef="calidad_avanzada_e_hal" targetRef="calidad_avanzada_e_uni" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_7" name="Yes" sourceRef="calidad_avanzada_e_hal" targetRef="calidad_avanzada_e_cor" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_8" sourceRef="calidad_avanzada_e_cor" targetRef="calidad_avanzada_e_uni" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_9" sourceRef="calidad_avanzada_e_uni" targetRef="calidad_avanzada_e_cer" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_10" sourceRef="calidad_avanzada_e_cer" targetRef="calidad_avanzada_e_fin" />
  </bpmn:process>
  <bpmn:process id="calidad_avanzada_proceso_auditora" isExecutable="false">
    <bpmn:laneSet id="calidad_avanzada_carriles_auditora">
      <bpmn:lane id="calidad_avanzada_carril_aud" name="Auditor">
        <bpmn:flowNodeRef>calidad_avanzada_a_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_a_pla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_a_aud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_a_inf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_a_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_a_cer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_avanzada_a_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="calidad_avanzada_a_ini" name="Receives the request">
      <bpmn:outgoing>calidad_avanzada_f0_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="calidad_avanzada_a_ini_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="calidad_avanzada_a_pla" name="Plan the audit">
      <bpmn:incoming>calidad_avanzada_f0_11</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="calidad_avanzada_a_aud" name="Audit on site">
      <bpmn:incoming>calidad_avanzada_f0_12</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="calidad_avanzada_a_inf" name="Send the report">
      <bpmn:incoming>calidad_avanzada_f0_13</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="calidad_avanzada_a_esp" name="Deadline to close findings (30 days)">
      <bpmn:incoming>calidad_avanzada_f0_14</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="calidad_avanzada_a_esp_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="calidad_avanzada_a_cer" name="Issue the certificate">
      <bpmn:incoming>calidad_avanzada_f0_15</bpmn:incoming>
      <bpmn:outgoing>calidad_avanzada_f0_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="calidad_avanzada_a_fin" name="Audit closed">
      <bpmn:incoming>calidad_avanzada_f0_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="calidad_avanzada_f0_11" sourceRef="calidad_avanzada_a_ini" targetRef="calidad_avanzada_a_pla" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_12" sourceRef="calidad_avanzada_a_pla" targetRef="calidad_avanzada_a_aud" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_13" sourceRef="calidad_avanzada_a_aud" targetRef="calidad_avanzada_a_inf" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_14" sourceRef="calidad_avanzada_a_inf" targetRef="calidad_avanzada_a_esp" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_15" sourceRef="calidad_avanzada_a_esp" targetRef="calidad_avanzada_a_cer" />
    <bpmn:sequenceFlow id="calidad_avanzada_f0_16" sourceRef="calidad_avanzada_a_cer" targetRef="calidad_avanzada_a_fin" />
  </bpmn:process>
  <bpmn:collaboration id="calidad_avanzada_colab1">
    <bpmn:participant id="calidad_avanzada_pool_preparacion" name="Preparation" processRef="calidad_avanzada_proceso_preparacion" />
  </bpmn:collaboration>
  <bpmn:process id="calidad_avanzada_proceso_preparacion" isExecutable="false">
    <bpmn:laneSet id="calidad_avanzada_carriles_preparacion">
