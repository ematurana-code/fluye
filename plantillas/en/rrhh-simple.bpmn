<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="rrhh_simple_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="rrhh_simple_colab0">
    <bpmn:participant id="rrhh_simple_pool_agencia" name="Company" processRef="rrhh_simple_proceso_agencia" />
  </bpmn:collaboration>
  <bpmn:process id="rrhh_simple_proceso_agencia" isExecutable="false">
    <bpmn:laneSet id="rrhh_simple_carriles_agencia">
      <bpmn:lane id="rrhh_simple_carril_col" name="Employee">
        <bpmn:flowNodeRef>rrhh_simple_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rrhh_simple_sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rrhh_simple_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rrhh_simple_otr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rrhh_simple_carril_jef" name="Manager">
        <bpmn:flowNodeRef>rrhh_simple_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rrhh_simple_apr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rrhh_simple_reg</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="rrhh_simple_ini" name="Wants to take vacation">
      <bpmn:outgoing>rrhh_simple_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="rrhh_simple_sol" name="Request the days off">
      <bpmn:documentation>States the start and end dates.</bpmn:documentation>
      <bpmn:incoming>rrhh_simple_f0_0</bpmn:incoming>
      <bpmn:incoming>rrhh_simple_f0_6</bpmn:incoming>
      <bpmn:outgoing>rrhh_simple_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="rrhh_simple_rev" name="Review the request">
      <bpmn:incoming>rrhh_simple_f0_1</bpmn:incoming>
      <bpmn:outgoing>rrhh_simple_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="rrhh_simple_apr" name="Approved?">
      <bpmn:incoming>rrhh_simple_f0_2</bpmn:incoming>
      <bpmn:outgoing>rrhh_simple_f0_3</bpmn:outgoing>
      <bpmn:outgoing>rrhh_simple_f0_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="rrhh_simple_reg" name="Record the vacation">
      <bpmn:incoming>rrhh_simple_f0_3</bpmn:incoming>
      <bpmn:outgoing>rrhh_simple_f0_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="rrhh_simple_fin" name="Vacation approved">
      <bpmn:incoming>rrhh_simple_f0_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="rrhh_simple_otr" name="Propose other dates">
      <bpmn:incoming>rrhh_simple_f0_5</bpmn:incoming>
      <bpmn:outgoing>rrhh_simple_f0_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="rrhh_simple_f0_0" sourceRef="rrhh_simple_ini" targetRef="rrhh_simple_sol" />
    <bpmn:sequenceFlow id="rrhh_simple_f0_1" sourceRef="rrhh_simple_sol" targetRef="rrhh_simple_rev" />
    <bpmn:sequenceFlow id="rrhh_simple_f0_2" sourceRef="rrhh_simple_rev" targetRef="rrhh_simple_apr" />
    <bpmn:sequenceFlow id="rrhh_simple_f0_3" name="Yes" sourceRef="rrhh_simple_apr" targetRef="rrhh_simple_reg" />
    <bpmn:sequenceFlow id="rrhh_simple_f0_4" sourceRef="rrhh_simple_reg" targetRef="rrhh_simple_fin" />
    <bpmn:sequenceFlow id="rrhh_simple_f0_5" name="No" sourceRef="rrhh_simple_apr" targetRef="rrhh_simple_otr" />
    <bpmn:sequenceFlow id="rrhh_simple_f0_6" sourceRef="rrhh_simple_otr" targetRef="rrhh_simple_sol" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="rrhh_simple_diagrama0" name="Vacation request">
    <bpmndi:BPMNPlane id="rrhh_simple_plano0" bpmnElement="rrhh_simple_colab0">
      <bpmndi:BPMNShape id="DI_rrhh_simple_pool_agencia" bpmnElement="rrhh_simple_pool_agencia" isHorizontal="true">
        <dc:Bounds x="80" y="60" width="1090" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_rrhh_simple_carril_col" bpmnElement="rrhh_simple_carril_col" isHorizontal="true">
        <dc:Bounds x="110" y="60" width="1060" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_rrhh_simple_carril_jef" bpmnElement="rrhh_simple_carril_jef" isHorizontal="true">
        <dc:Bounds x="110" y="330" width="1060" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_rrhh_simple_ini" bpmnElement="rrhh_simple_ini">
        <dc:Bounds x="192" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_rrhh_simple_sol" bpmnElement="rrhh_simple_sol">
        <dc:Bounds x="320" y="103" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_rrhh_simple_rev" bpmnElement="rrhh_simple_rev">
        <dc:Bounds x="490" y="373" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_rrhh_simple_apr" bpmnElement="rrhh_simple_apr" isMarkerVisible="false">
        <dc:Bounds x="697" y="382" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_rrhh_simple_reg" bpmnElement="rrhh_simple_reg">
        <dc:Bounds x="830" y="373" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_rrhh_simple_fin" bpmnElement="rrhh_simple_fin">
        <dc:Bounds x="1042" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_rrhh_simple_otr" bpmnElement="rrhh_simple_otr">
        <dc:Bounds x="660" y="223" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_rrhh_simple_f0_0" bpmnElement="rrhh_simple_f0_0">
        <di:waypoint x="228" y="135" />
        <di:waypoint x="320" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_rrhh_simple_f0_1" bpmnElement="rrhh_simple_f0_1">
        <di:waypoint x="440" y="135" />
        <di:waypoint x="465" y="135" />
        <di:waypoint x="465" y="405" />
        <di:waypoint x="490" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_rrhh_simple_f0_2" bpmnElement="rrhh_simple_f0_2">
        <di:waypoint x="610" y="405" />
        <di:waypoint x="697" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_rrhh_simple_f0_3" bpmnElement="rrhh_simple_f0_3">
        <di:waypoint x="743" y="405" />
        <di:waypoint x="830" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_rrhh_simple_f0_4" bpmnElement="rrhh_simple_f0_4">
        <di:waypoint x="950" y="405" />
        <di:waypoint x="996" y="405" />
        <di:waypoint x="996" y="135" />
        <di:waypoint x="1042" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_rrhh_simple_f0_5" bpmnElement="rrhh_simple_f0_5">
        <di:waypoint x="720" y="382" />
        <di:waypoint x="720" y="287" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_rrhh_simple_f0_6" bpmnElement="rrhh_simple_f0_6">
        <di:waypoint x="660" y="255" />
        <di:waypoint x="380" y="255" />
        <di:waypoint x="380" y="167" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
