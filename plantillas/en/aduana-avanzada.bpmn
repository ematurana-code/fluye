      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_aduana_avanzada_carril_docu" bpmnElement="aduana_avanzada_carril_docu" isHorizontal="true">
        <dc:Bounds x="110" y="450" width="2420" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_aduana_avanzada_carril_oper" bpmnElement="aduana_avanzada_carril_oper" isHorizontal="true">
        <dc:Bounds x="110" y="600" width="2420" height="150" />
      </bpmndi:BPMNShape>
