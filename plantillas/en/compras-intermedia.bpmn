<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="compras_intermedia_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="compras_intermedia_colab0">
    <bpmn:participant id="compras_intermedia_pool_empresa" name="Company" processRef="compras_intermedia_proceso_empresa" />
  </bpmn:collaboration>
  <bpmn:process id="compras_intermedia_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="compras_intermedia_carriles_empresa">
      <bpmn:lane id="compras_intermedia_carril_sol" name="Requester">
        <bpmn:flowNodeRef>compras_intermedia_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_intermedia_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compras_intermedia_carril_cmp" name="Purchasing">
        <bpmn:flowNodeRef>compras_intermedia_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_intermedia_cmpa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_intermedia_lim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_intermedia_uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_intermedia_oc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_intermedia_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_intermedia_fac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_intermedia_jun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_intermedia_cer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compras_intermedia_carril_jef" name="Manager">
        <bpmn:flowNodeRef>compras_intermedia_aut</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compras_intermedia_carril_bod" name="Warehouse">
        <bpmn:flowNodeRef>compras_intermedia_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_intermedia_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_intermedia_rcl</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="compras_intermedia_ini" name="Request approved">
      <bpmn:outgoing>compras_intermedia_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="compras_intermedia_cot" name="Request three quotes">
      <bpmn:incoming>compras_intermedia_f0_0</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="compras_intermedia_cmpa" name="Compare the quotes">
      <bpmn:documentation>Price, delivery time and payment terms.</bpmn:documentation>
      <bpmn:incoming>compras_intermedia_f0_1</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="compras_intermedia_lim" name="Over the spending limit?">
      <bpmn:incoming>compras_intermedia_f0_2</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_3</bpmn:outgoing>
      <bpmn:outgoing>compras_intermedia_f0_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="compras_intermedia_aut" name="Authorize the purchase">
      <bpmn:incoming>compras_intermedia_f0_4</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="compras_intermedia_uni">
      <bpmn:incoming>compras_intermedia_f0_3</bpmn:incoming>
      <bpmn:incoming>compras_intermedia_f0_5</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="compras_intermedia_oc" name="Issue the purchase order">
      <bpmn:incoming>compras_intermedia_f0_6</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="compras_intermedia_par">
      <bpmn:incoming>compras_intermedia_f0_7</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_8</bpmn:outgoing>
      <bpmn:outgoing>compras_intermedia_f0_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="compras_intermedia_fac" name="Record the invoice">
      <bpmn:incoming>compras_intermedia_f0_8</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="compras_intermedia_rec" name="Receive and check the goods">
      <bpmn:incoming>compras_intermedia_f0_9</bpmn:incoming>
      <bpmn:incoming>compras_intermedia_f0_14</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="compras_intermedia_con" name="Arrived as ordered?">
      <bpmn:incoming>compras_intermedia_f0_11</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_12</bpmn:outgoing>
      <bpmn:outgoing>compras_intermedia_f0_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="compras_intermedia_rcl" name="File a claim with the supplier">
      <bpmn:incoming>compras_intermedia_f0_13</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="compras_intermedia_jun">
      <bpmn:incoming>compras_intermedia_f0_10</bpmn:incoming>
      <bpmn:incoming>compras_intermedia_f0_12</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="compras_intermedia_cer" name="Close the purchase order">
      <bpmn:incoming>compras_intermedia_f0_15</bpmn:incoming>
      <bpmn:outgoing>compras_intermedia_f0_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="compras_intermedia_fin" name="Purchase closed">
      <bpmn:incoming>compras_intermedia_f0_16</bpmn:incoming>
    </bpmn:endEvent>
