<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="legal_simple_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="legal_simple_colab0">
    <bpmn:participant id="legal_simple_pool_empresa" name="Company" processRef="legal_simple_proceso_empresa" />
  </bpmn:collaboration>
  <bpmn:process id="legal_simple_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="legal_simple_carriles_empresa">
      <bpmn:lane id="legal_simple_carril_are" name="Requesting area">
        <bpmn:flowNodeRef>legal_simple_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_simple_env</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_simple_cor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal_simple_carril_leg" name="Legal">
        <bpmn:flowNodeRef>legal_simple_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_simple_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_simple_vis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_simple_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="legal_simple_ini" name="A contract is needed">
      <bpmn:outgoing>legal_simple_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="legal_simple_env" name="Send the draft to Legal">
      <bpmn:incoming>legal_simple_f0_0</bpmn:incoming>
      <bpmn:incoming>legal_simple_f0_6</bpmn:incoming>
      <bpmn:outgoing>legal_simple_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="legal_simple_rev" name="Review clauses and risks">
      <bpmn:incoming>legal_simple_f0_1</bpmn:incoming>
      <bpmn:outgoing>legal_simple_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="legal_simple_dec" name="Satisfactory?">
      <bpmn:incoming>legal_simple_f0_2</bpmn:incoming>
      <bpmn:outgoing>legal_simple_f0_3</bpmn:outgoing>
      <bpmn:outgoing>legal_simple_f0_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="legal_simple_vis" name="Approve the contract">
      <bpmn:incoming>legal_simple_f0_3</bpmn:incoming>
      <bpmn:outgoing>legal_simple_f0_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="legal_simple_fin" name="Contract approved">
      <bpmn:incoming>legal_simple_f0_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="legal_simple_cor" name="Correct the draft">
      <bpmn:incoming>legal_simple_f0_5</bpmn:incoming>
      <bpmn:outgoing>legal_simple_f0_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="legal_simple_f0_0" sourceRef="legal_simple_ini" targetRef="legal_simple_env" />
    <bpmn:sequenceFlow id="legal_simple_f0_1" sourceRef="legal_simple_env" targetRef="legal_simple_rev" />
    <bpmn:sequenceFlow id="legal_simple_f0_2" sourceRef="legal_simple_rev" targetRef="legal_simple_dec" />
    <bpmn:sequenceFlow id="legal_simple_f0_3" name="Yes" sourceRef="legal_simple_dec" targetRef="legal_simple_vis" />
    <bpmn:sequenceFlow id="legal_simple_f0_4" sourceRef="legal_simple_vis" targetRef="legal_simple_fin" />
    <bpmn:sequenceFlow id="legal_simple_f0_5" name="No" sourceRef="legal_simple_dec" targetRef="legal_simple_cor" />
    <bpmn:sequenceFlow id="legal_simple_f0_6" sourceRef="legal_simple_cor" targetRef="legal_simple_env" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="legal_simple_diagrama0" name="Contract review">
    <bpmndi:BPMNPlane id="legal_simple_plano0" bpmnElement="legal_simple_colab0">
      <bpmndi:BPMNShape id="DI_legal_simple_pool_empresa" bpmnElement="legal_simple_pool_empresa" isHorizontal="true">
        <dc:Bounds x="80" y="60" width="1090" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_legal_simple_carril_are" bpmnElement="legal_simple_carril_are" isHorizontal="true">
        <dc:Bounds x="110" y="60" width="1060" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_legal_simple_carril_leg" bpmnElement="legal_simple_carril_leg" isHorizontal="true">
        <dc:Bounds x="110" y="330" width="1060" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_legal_simple_ini" bpmnElement="legal_simple_ini">
        <dc:Bounds x="192" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_legal_simple_env" bpmnElement="legal_simple_env">
        <dc:Bounds x="320" y="103" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_legal_simple_rev" bpmnElement="legal_simple_rev">
        <dc:Bounds x="490" y="373" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_legal_simple_dec" bpmnElement="legal_simple_dec" isMarkerVisible="false">
        <dc:Bounds x="697" y="382" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_legal_simple_vis" bpmnElement="legal_simple_vis">
        <dc:Bounds x="830" y="373" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_legal_simple_fin" bpmnElement="legal_simple_fin">
        <dc:Bounds x="1042" y="387" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_legal_simple_cor" bpmnElement="legal_simple_cor">
        <dc:Bounds x="660" y="223" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_legal_simple_f0_0" bpmnElement="legal_simple_f0_0">
        <di:waypoint x="228" y="135" />
        <di:waypoint x="320" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_legal_simple_f0_1" bpmnElement="legal_simple_f0_1">
        <di:waypoint x="440" y="135" />
        <di:waypoint x="465" y="135" />
        <di:waypoint x="465" y="405" />
        <di:waypoint x="490" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_legal_simple_f0_2" bpmnElement="legal_simple_f0_2">
        <di:waypoint x="610" y="405" />
        <di:waypoint x="697" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_legal_simple_f0_3" bpmnElement="legal_simple_f0_3">
        <di:waypoint x="743" y="405" />
        <di:waypoint x="830" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_legal_simple_f0_4" bpmnElement="legal_simple_f0_4">
        <di:waypoint x="950" y="405" />
        <di:waypoint x="1042" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_legal_simple_f0_5" bpmnElement="legal_simple_f0_5">
        <di:waypoint x="720" y="382" />
        <di:waypoint x="720" y="287" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_legal_simple_f0_6" bpmnElement="legal_simple_f0_6">
        <di:waypoint x="660" y="255" />
        <di:waypoint x="380" y="255" />
        <di:waypoint x="380" y="167" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
