    <bpmn:sequenceFlow id="ventas_intermedia_f0_10" sourceRef="ventas_intermedia_ent" targetRef="ventas_intermedia_jun" />
    <bpmn:sequenceFlow id="ventas_intermedia_f0_11" sourceRef="ventas_intermedia_fac" targetRef="ventas_intermedia_jun" />
    <bpmn:sequenceFlow id="ventas_intermedia_f0_12" sourceRef="ventas_intermedia_jun" targetRef="ventas_intermedia_seg" />
    <bpmn:sequenceFlow id="ventas_intermedia_f0_13" sourceRef="ventas_intermedia_seg" targetRef="ventas_intermedia_fin" />
  </bpmn:process>
