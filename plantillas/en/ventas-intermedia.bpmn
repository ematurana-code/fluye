<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="ventas_intermedia_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="ventas_intermedia_colab0">
    <bpmn:participant id="ventas_intermedia_pool_empresa" name="Company" processRef="ventas_intermedia_proceso_empresa" />
  </bpmn:collaboration>
  <bpmn:process id="ventas_intermedia_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="ventas_intermedia_carriles_empresa">
      <bpmn:lane id="ventas_intermedia_carril_eje" name="Sales rep">
        <bpmn:flowNodeRef>ventas_intermedia_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_intermedia_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_intermedia_neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_intermedia_ace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_intermedia_aju</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_intermedia_fir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_intermedia_seg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_intermedia_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ventas_intermedia_carril_jef" name="Sales manager">
        <bpmn:flowNodeRef>ventas_intermedia_apb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_intermedia_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_intermedia_jun</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ventas_intermedia_carril_ope" name="Operations">
        <bpmn:flowNodeRef>ventas_intermedia_ent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ventas_intermedia_carril_fct" name="Billing">
        <bpmn:flowNodeRef>ventas_intermedia_fac</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ventas_intermedia_ini" name="Interested customer">
      <bpmn:outgoing>ventas_intermedia_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ventas_intermedia_cot" name="Prepare and send the quote">
      <bpmn:incoming>ventas_intermedia_f0_0</bpmn:incoming>
      <bpmn:outgoing>ventas_intermedia_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ventas_intermedia_neg" name="Negotiate terms">
      <bpmn:incoming>ventas_intermedia_f0_1</bpmn:incoming>
      <bpmn:incoming>ventas_intermedia_f0_5</bpmn:incoming>
      <bpmn:outgoing>ventas_intermedia_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ventas_intermedia_ace" name="Does the customer accept?">
      <bpmn:incoming>ventas_intermedia_f0_2</bpmn:incoming>
      <bpmn:outgoing>ventas_intermedia_f0_3</bpmn:outgoing>
      <bpmn:outgoing>ventas_intermedia_f0_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ventas_intermedia_aju" name="Adjust the proposal">
      <bpmn:incoming>ventas_intermedia_f0_4</bpmn:incoming>
      <bpmn:outgoing>ventas_intermedia_f0_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ventas_intermedia_fir" name="Sign the contract">
      <bpmn:incoming>ventas_intermedia_f0_3</bpmn:incoming>
      <bpmn:outgoing>ventas_intermedia_f0_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ventas_intermedia_apb" name="Approve the contract">
      <bpmn:incoming>ventas_intermedia_f0_6</bpmn:incoming>
      <bpmn:outgoing>ventas_intermedia_f0_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ventas_intermedia_par">
      <bpmn:incoming>ventas_intermedia_f0_7</bpmn:incoming>
      <bpmn:outgoing>ventas_intermedia_f0_8</bpmn:outgoing>
      <bpmn:outgoing>ventas_intermedia_f0_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="ventas_intermedia_ent" name="Schedule the delivery">
      <bpmn:incoming>ventas_intermedia_f0_8</bpmn:incoming>
      <bpmn:outgoing>ventas_intermedia_f0_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ventas_intermedia_fac" name="Issue the invoice">
      <bpmn:incoming>ventas_intermedia_f0_9</bpmn:incoming>
      <bpmn:outgoing>ventas_intermedia_f0_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ventas_intermedia_jun">
      <bpmn:incoming>ventas_intermedia_f0_10</bpmn:incoming>
      <bpmn:incoming>ventas_intermedia_f0_11</bpmn:incoming>
      <bpmn:outgoing>ventas_intermedia_f0_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="ventas_intermedia_seg" name="Follow up with the customer">
      <bpmn:incoming>ventas_intermedia_f0_12</bpmn:incoming>
      <bpmn:outgoing>ventas_intermedia_f0_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ventas_intermedia_fin" name="Sale closed">
      <bpmn:incoming>ventas_intermedia_f0_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ventas_intermedia_f0_0" sourceRef="ventas_intermedia_ini" targetRef="ventas_intermedia_cot" />
    <bpmn:sequenceFlow id="ventas_intermedia_f0_1" sourceRef="ventas_intermedia_cot" targetRef="ventas_intermedia_neg" />
