    <bpmn:sequenceFlow id="finanzas_intermedia_f0_10" sourceRef="finanzas_intermedia_jun" targetRef="finanzas_intermedia_pro" />
    <bpmn:sequenceFlow id="finanzas_intermedia_f0_11" sourceRef="finanzas_intermedia_pro" targetRef="finanzas_intermedia_pag" />
    <bpmn:sequenceFlow id="finanzas_intermedia_f0_12" sourceRef="finanzas_intermedia_pag" targetRef="finanzas_intermedia_com" />
    <bpmn:sequenceFlow id="finanzas_intermedia_f0_13" sourceRef="finanzas_intermedia_com" targetRef="finanzas_intermedia_fin" />
  </bpmn:process>
