<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="finanzas_intermedia_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="finanzas_intermedia_colab0">
    <bpmn:participant id="finanzas_intermedia_pool_empresa" name="Company" processRef="finanzas_intermedia_proceso_empresa" />
  </bpmn:collaboration>
  <bpmn:process id="finanzas_intermedia_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="finanzas_intermedia_carriles_empresa">
      <bpmn:lane id="finanzas_intermedia_carril_cnt" name="Accounting">
        <bpmn:flowNodeRef>finanzas_intermedia_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finanzas_intermedia_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finanzas_intermedia_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finanzas_intermedia_coi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finanzas_intermedia_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finanzas_intermedia_cbz</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finanzas_intermedia_carril_are" name="Requesting area">
        <bpmn:flowNodeRef>finanzas_intermedia_acl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finanzas_intermedia_apr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finanzas_intermedia_jun</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finanzas_intermedia_carril_tes" name="Treasury">
        <bpmn:flowNodeRef>finanzas_intermedia_pro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finanzas_intermedia_pag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finanzas_intermedia_com</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finanzas_intermedia_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="finanzas_intermedia_ini" name="An invoice arrives">
      <bpmn:outgoing>finanzas_intermedia_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="finanzas_intermedia_reg" name="Record the invoice">
      <bpmn:incoming>finanzas_intermedia_f0_0</bpmn:incoming>
      <bpmn:outgoing>finanzas_intermedia_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="finanzas_intermedia_val" name="Match against the purchase order">
      <bpmn:incoming>finanzas_intermedia_f0_1</bpmn:incoming>
      <bpmn:incoming>finanzas_intermedia_f0_5</bpmn:incoming>
      <bpmn:outgoing>finanzas_intermedia_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="finanzas_intermedia_coi" name="Matches the order?">
      <bpmn:incoming>finanzas_intermedia_f0_2</bpmn:incoming>
      <bpmn:outgoing>finanzas_intermedia_f0_3</bpmn:outgoing>
      <bpmn:outgoing>finanzas_intermedia_f0_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="finanzas_intermedia_acl" name="Request a clarification or credit note">
      <bpmn:incoming>finanzas_intermedia_f0_4</bpmn:incoming>
      <bpmn:outgoing>finanzas_intermedia_f0_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="finanzas_intermedia_par">
      <bpmn:incoming>finanzas_intermedia_f0_3</bpmn:incoming>
      <bpmn:outgoing>finanzas_intermedia_f0_6</bpmn:outgoing>
      <bpmn:outgoing>finanzas_intermedia_f0_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="finanzas_intermedia_cbz" name="Book the invoice">
      <bpmn:incoming>finanzas_intermedia_f0_6</bpmn:incoming>
      <bpmn:outgoing>finanzas_intermedia_f0_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="finanzas_intermedia_apr" name="Approve the payment">
      <bpmn:incoming>finanzas_intermedia_f0_7</bpmn:incoming>
      <bpmn:outgoing>finanzas_intermedia_f0_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="finanzas_intermedia_jun">
      <bpmn:incoming>finanzas_intermedia_f0_8</bpmn:incoming>
      <bpmn:incoming>finanzas_intermedia_f0_9</bpmn:incoming>
      <bpmn:outgoing>finanzas_intermedia_f0_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="finanzas_intermedia_pro" name="Schedule the payment">
      <bpmn:incoming>finanzas_intermedia_f0_10</bpmn:incoming>
      <bpmn:outgoing>finanzas_intermedia_f0_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="finanzas_intermedia_pag" name="Pay by bank transfer">
      <bpmn:incoming>finanzas_intermedia_f0_11</bpmn:incoming>
      <bpmn:outgoing>finanzas_intermedia_f0_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="finanzas_intermedia_com" name="Send the receipt to the supplier">
      <bpmn:incoming>finanzas_intermedia_f0_12</bpmn:incoming>
      <bpmn:outgoing>finanzas_intermedia_f0_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="finanzas_intermedia_fin" name="Invoice paid">
      <bpmn:incoming>finanzas_intermedia_f0_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="finanzas_intermedia_f0_0" sourceRef="finanzas_intermedia_ini" targetRef="finanzas_intermedia_reg" />
    <bpmn:sequenceFlow id="finanzas_intermedia_f0_1" sourceRef="finanzas_intermedia_reg" targetRef="finanzas_intermedia_val" />
