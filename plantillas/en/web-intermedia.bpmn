<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="web_intermedia_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="web_intermedia_colab0">
    <bpmn:participant id="web_intermedia_pool_sistema" name="Web system" processRef="web_intermedia_proceso_sistema" />
  </bpmn:collaboration>
  <bpmn:process id="web_intermedia_proceso_sistema" isExecutable="false">
    <bpmn:laneSet id="web_intermedia_carriles_sistema">
      <bpmn:lane id="web_intermedia_carril_usu" name="User">
        <bpmn:flowNodeRef>web_intermedia_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_ing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_pan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="web_intermedia_carril_web" name="Web system">
        <bpmn:flowNodeRef>web_intermedia_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_ses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_jun</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="web_intermedia_carril_seg" name="Security">
        <bpmn:flowNodeRef>web_intermedia_bit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_sum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_int</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_blo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_intermedia_fbl</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="web_intermedia_ini" name="Wants to log in">
      <bpmn:outgoing>web_intermedia_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="web_intermedia_ing" name="Enter username and password">
      <bpmn:incoming>web_intermedia_f0_0</bpmn:incoming>
      <bpmn:incoming>web_intermedia_f0_15</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="web_intermedia_val" name="Validate the credentials">
      <bpmn:incoming>web_intermedia_f0_1</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="web_intermedia_dec" name="Correct?">
      <bpmn:incoming>web_intermedia_f0_2</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_3</bpmn:outgoing>
      <bpmn:outgoing>web_intermedia_f0_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="web_intermedia_err" name="Show an error message">
      <bpmn:incoming>web_intermedia_f0_13</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="web_intermedia_par">
      <bpmn:incoming>web_intermedia_f0_3</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_5</bpmn:outgoing>
      <bpmn:outgoing>web_intermedia_f0_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="web_intermedia_ses" name="Create the secure session">
      <bpmn:incoming>web_intermedia_f0_5</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="web_intermedia_bit" name="Log the access">
      <bpmn:documentation>Date, time, IP address and browser of the login.</bpmn:documentation>
      <bpmn:incoming>web_intermedia_f0_6</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="web_intermedia_jun">
      <bpmn:incoming>web_intermedia_f0_7</bpmn:incoming>
      <bpmn:incoming>web_intermedia_f0_8</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="web_intermedia_pan" name="View the main dashboard">
      <bpmn:incoming>web_intermedia_f0_9</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="web_intermedia_fin" name="Logged in">
      <bpmn:incoming>web_intermedia_f0_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="web_intermedia_sum" name="Count a failed attempt">
      <bpmn:incoming>web_intermedia_f0_4</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="web_intermedia_int" name="More than 3 attempts?">
      <bpmn:incoming>web_intermedia_f0_11</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_12</bpmn:outgoing>
      <bpmn:outgoing>web_intermedia_f0_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="web_intermedia_blo" name="Lock the account for 15 minutes">
      <bpmn:documentation>Protects the account if someone tries to guess the password.</bpmn:documentation>
      <bpmn:incoming>web_intermedia_f0_12</bpmn:incoming>
      <bpmn:outgoing>web_intermedia_f0_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="web_intermedia_fbl" name="Account locked">
      <bpmn:incoming>web_intermedia_f0_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="web_intermedia_f0_0" sourceRef="web_intermedia_ini" targetRef="web_intermedia_ing" />
    <bpmn:sequenceFlow id="web_intermedia_f0_1" sourceRef="web_intermedia_ing" targetRef="web_intermedia_val" />
    <bpmn:sequenceFlow id="web_intermedia_f0_2" sourceRef="web_intermedia_val" targetRef="web_intermedia_dec" />
    <bpmn:sequenceFlow id="web_intermedia_f0_3" name="Yes" sourceRef="web_intermedia_dec" targetRef="web_intermedia_par" />
    <bpmn:sequenceFlow id="web_intermedia_f0_4" name="No" sourceRef="web_intermedia_dec" targetRef="web_intermedia_sum" />
    <bpmn:sequenceFlow id="web_intermedia_f0_5" sourceRef="web_intermedia_par" targetRef="web_intermedia_ses" />
    <bpmn:sequenceFlow id="web_intermedia_f0_6" sourceRef="web_intermedia_par" targetRef="web_intermedia_bit" />
    <bpmn:sequenceFlow id="web_intermedia_f0_7" sourceRef="web_intermedia_ses" targetRef="web_intermedia_jun" />
    <bpmn:sequenceFlow id="web_intermedia_f0_8" sourceRef="web_intermedia_bit" targetRef="web_intermedia_jun" />
    <bpmn:sequenceFlow id="web_intermedia_f0_9" sourceRef="web_intermedia_jun" targetRef="web_intermedia_pan" />
    <bpmn:sequenceFlow id="web_intermedia_f0_10" sourceRef="web_intermedia_pan" targetRef="web_intermedia_fin" />
    <bpmn:sequenceFlow id="web_intermedia_f0_11" sourceRef="web_intermedia_sum" targetRef="web_intermedia_int" />
    <bpmn:sequenceFlow id="web_intermedia_f0_12" name="Yes" sourceRef="web_intermedia_int" targetRef="web_intermedia_blo" />
    <bpmn:sequenceFlow id="web_intermedia_f0_13" name="No" sourceRef="web_intermedia_int" targetRef="web_intermedia_err" />
    <bpmn:sequenceFlow id="web_intermedia_f0_14" sourceRef="web_intermedia_blo" targetRef="web_intermedia_fbl" />
    <bpmn:sequenceFlow id="web_intermedia_f0_15" sourceRef="web_intermedia_err" targetRef="web_intermedia_ing" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="web_intermedia_diagrama0" name="Login">
    <bpmndi:BPMNPlane id="web_intermedia_plano0" bpmnElement="web_intermedia_colab0">
      <bpmndi:BPMNShape id="DI_web_intermedia_pool_sistema" bpmnElement="web_intermedia_pool_sistema" isHorizontal="true">
        <dc:Bounds x="80" y="60" width="1770" height="690" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_web_intermedia_carril_usu" bpmnElement="web_intermedia_carril_usu" isHorizontal="true">
