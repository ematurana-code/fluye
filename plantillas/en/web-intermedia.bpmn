      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_web_intermedia_blo" bpmnElement="web_intermedia_blo">
        <dc:Bounds x="1000" y="643" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_web_intermedia_fbl" bpmnElement="web_intermedia_fbl">
