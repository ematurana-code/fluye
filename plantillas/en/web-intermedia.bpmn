      <bpmndi:BPMNShape id="DI_web_intermedia_ses" bpmnElement="web_intermedia_ses">
        <dc:Bounds x="1170" y="253" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_web_intermedia_bit" bpmnElement="web_intermedia_bit">
        <dc:Bounds x="1170" y="523" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_web_intermedia_jun" bpmnElement="web_intermedia_jun">
        <dc:Bounds x="1377" y="262" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_web_intermedia_pan" bpmnElement="web_intermedia_pan">
        <dc:Bounds x="1510" y="103" width="120" height="64" />
      </bpmndi:BPMNShape>
