<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="compras_simple_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="compras_simple_colab0">
    <bpmn:participant id="compras_simple_pool_empresa" name="Company" processRef="compras_simple_proceso_empresa" />
  </bpmn:collaboration>
  <bpmn:process id="compras_simple_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="compras_simple_carriles_empresa">
      <bpmn:lane id="compras_simple_carril_sol" name="Requester">
        <bpmn:flowNodeRef>compras_simple_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_simple_com</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_simple_aju</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compras_simple_carril_jef" name="Manager">
        <bpmn:flowNodeRef>compras_simple_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_simple_apr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_simple_env</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_simple_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="compras_simple_ini" name="Needs to buy something">
      <bpmn:outgoing>compras_simple_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="compras_simple_com" name="Fill in the purchase request">
      <bpmn:documentation>What is needed, how much and by when.</bpmn:documentation>
      <bpmn:incoming>compras_simple_f0_0</bpmn:incoming>
      <bpmn:incoming>compras_simple_f0_6</bpmn:incoming>
      <bpmn:outgoing>compras_simple_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="compras_simple_rev" name="Review the request">
      <bpmn:incoming>compras_simple_f0_1</bpmn:incoming>
      <bpmn:outgoing>compras_simple_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="compras_simple_apr" name="Approved?">
      <bpmn:incoming>compras_simple_f0_2</bpmn:incoming>
      <bpmn:outgoing>compras_simple_f0_3</bpmn:outgoing>
      <bpmn:outgoing>compras_simple_f0_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="compras_simple_env" name="Send to purchasing">
      <bpmn:incoming>compras_simple_f0_3</bpmn:incoming>
      <bpmn:outgoing>compras_simple_f0_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="compras_simple_fin" name="Request approved">
      <bpmn:incoming>compras_simple_f0_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="compras_simple_aju" name="Adjust the request">
      <bpmn:incoming>compras_simple_f0_5</bpmn:incoming>
      <bpmn:outgoing>compras_simple_f0_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="compras_simple_f0_0" sourceRef="compras_simple_ini" targetRef="compras_simple_com" />
    <bpmn:sequenceFlow id="compras_simple_f0_1" sourceRef="compras_simple_com" targetRef="compras_simple_rev" />
    <bpmn:sequenceFlow id="compras_simple_f0_2" sourceRef="compras_simple_rev" targetRef="compras_simple_apr" />
    <bpmn:sequenceFlow id="compras_simple_f0_3" name="Yes" sourceRef="compras_simple_apr" targetRef="compras_simple_env" />
    <bpmn:sequenceFlow id="compras_simple_f0_4" sourceRef="compras_simple_env" targetRef="compras_simple_fin" />
    <bpmn:sequenceFlow id="compras_simple_f0_5" name="No" sourceRef="compras_simple_apr" targetRef="compras_simple_aju" />
    <bpmn:sequenceFlow id="compras_simple_f0_6" sourceRef="compras_simple_aju" targetRef="compras_simple_com" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="compras_simple_diagrama0" name="Purchase request">
    <bpmndi:BPMNPlane id="compras_simple_plano0" bpmnElement="compras_simple_colab0">
      <bpmndi:BPMNShape id="DI_compras_simple_pool_empresa" bpmnElement="compras_simple_pool_empresa" isHorizontal="true">
        <dc:Bounds x="80" y="60" width="1090" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_compras_simple_carril_sol" bpmnElement="compras_simple_carril_sol" isHorizontal="true">
        <dc:Bounds x="110" y="60" width="1060" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_compras_simple_carril_jef" bpmnElement="compras_simple_carril_jef" isHorizontal="true">
        <dc:Bounds x="110" y="330" width="1060" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_compras_simple_ini" bpmnElement="compras_simple_ini">
        <dc:Bounds x="192" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_compras_simple_com" bpmnElement="compras_simple_com">
        <dc:Bounds x="320" y="103" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_compras_simple_rev" bpmnElement="compras_simple_rev">
        <dc:Bounds x="490" y="373" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_compras_simple_apr" bpmnElement="compras_simple_apr" isMarkerVisible="false">
        <dc:Bounds x="697" y="382" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_compras_simple_env" bpmnElement="compras_simple_env">
        <dc:Bounds x="830" y="373" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_compras_simple_fin" bpmnElement="compras_simple_fin">
        <dc:Bounds x="1042" y="387" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_compras_simple_aju" bpmnElement="compras_simple_aju">
        <dc:Bounds x="660" y="223" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_compras_simple_f0_0" bpmnElement="compras_simple_f0_0">
        <di:waypoint x="228" y="135" />
        <di:waypoint x="320" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_compras_simple_f0_1" bpmnElement="compras_simple_f0_1">
        <di:waypoint x="440" y="135" />
        <di:waypoint x="465" y="135" />
        <di:waypoint x="465" y="405" />
        <di:waypoint x="490" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_compras_simple_f0_2" bpmnElement="compras_simple_f0_2">
        <di:waypoint x="610" y="405" />
        <di:waypoint x="697" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_compras_simple_f0_3" bpmnElement="compras_simple_f0_3">
        <di:waypoint x="743" y="405" />
        <di:waypoint x="830" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_compras_simple_f0_4" bpmnElement="compras_simple_f0_4">
        <di:waypoint x="950" y="405" />
        <di:waypoint x="1042" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_compras_simple_f0_5" bpmnElement="compras_simple_f0_5">
        <di:waypoint x="720" y="382" />
        <di:waypoint x="720" y="287" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_compras_simple_f0_6" bpmnElement="compras_simple_f0_6">
        <di:waypoint x="660" y="255" />
        <di:waypoint x="380" y="255" />
        <di:waypoint x="380" y="167" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
