      <bpmn:outgoing>legal_intermedia_f0_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="legal_intermedia_fin" name="Contract in force">
      <bpmn:incoming>legal_intermedia_f0_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="legal_intermedia_f0_0" sourceRef="legal_intermedia_ini" targetRef="legal_intermedia_sol" />
