<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="legal_intermedia_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="legal_intermedia_colab0">
    <bpmn:participant id="legal_intermedia_pool_empresa" name="Company" processRef="legal_intermedia_proceso_empresa" />
  </bpmn:collaboration>
  <bpmn:process id="legal_intermedia_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="legal_intermedia_carriles_empresa">
      <bpmn:lane id="legal_intermedia_carril_are" name="Requesting area">
        <bpmn:flowNodeRef>legal_intermedia_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_intermedia_sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_intermedia_avi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_intermedia_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal_intermedia_carril_leg" name="Legal">
        <bpmn:flowNodeRef>legal_intermedia_red</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_intermedia_neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_intermedia_acu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_intermedia_aju</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_intermedia_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_intermedia_car</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal_intermedia_carril_ger" name="Management">
        <bpmn:flowNodeRef>legal_intermedia_fir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>legal_intermedia_jun</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal_intermedia_carril_adm" name="Administration">
        <bpmn:flowNodeRef>legal_intermedia_reg</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="legal_intermedia_ini" name="A supplier is chosen">
      <bpmn:outgoing>legal_intermedia_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="legal_intermedia_sol" name="Request the contract from Legal">
      <bpmn:incoming>legal_intermedia_f0_0</bpmn:incoming>
      <bpmn:outgoing>legal_intermedia_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="legal_intermedia_red" name="Draft the contract">
      <bpmn:incoming>legal_intermedia_f0_1</bpmn:incoming>
      <bpmn:outgoing>legal_intermedia_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="legal_intermedia_neg" name="Negotiate with the supplier">
