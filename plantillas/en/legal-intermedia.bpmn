      <bpmn:incoming>legal_intermedia_f0_10</bpmn:incoming>
      <bpmn:outgoing>legal_intermedia_f0_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="legal_intermedia_reg" name="Record in the contract system">
