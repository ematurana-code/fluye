      <bpmn:incoming>legal_intermedia_f0_6</bpmn:incoming>
      <bpmn:outgoing>legal_intermedia_f0_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="legal_intermedia_acu" name="Agreement reached?">
      <bpmn:incoming>legal_intermedia_f0_3</bpmn:incoming>
