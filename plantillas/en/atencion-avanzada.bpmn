<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="atencion_avanzada_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="atencion_avanzada_colab0">
    <bpmn:participant id="atencion_avanzada_pool_cliente" name="Customer" processRef="atencion_avanzada_proceso_cliente" />
    <bpmn:participant id="atencion_avanzada_pool_empresa" name="Company" processRef="atencion_avanzada_proceso_empresa" />
    <bpmn:participant id="atencion_avanzada_pool_tecnico" name="External repair service" processRef="atencion_avanzada_proceso_tecnico" />
    <bpmn:messageFlow id="atencion_avanzada_m0_0" name="Claim" sourceRef="atencion_avanzada_c_rec" targetRef="atencion_avanzada_e_ini" />
    <bpmn:messageFlow id="atencion_avanzada_m0_1" name="Product" sourceRef="atencion_avanzada_e_env" targetRef="atencion_avanzada_s_ini" />
    <bpmn:messageFlow id="atencion_avanzada_m0_2" name="Report" sourceRef="atencion_avanzada_s_inf" targetRef="atencion_avanzada_e_inf" />
    <bpmn:messageFlow id="atencion_avanzada_m0_3" name="Answer" sourceRef="atencion_avanzada_e_avi" targetRef="atencion_avanzada_c_res" />
  </bpmn:collaboration>
  <bpmn:process id="atencion_avanzada_proceso_cliente" isExecutable="false">
    <bpmn:laneSet id="atencion_avanzada_carriles_cliente">
      <bpmn:lane id="atencion_avanzada_carril_cli" name="Customer">
        <bpmn:flowNodeRef>atencion_avanzada_c_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_c_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_c_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_c_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="atencion_avanzada_c_ini" name="The product fails">
      <bpmn:outgoing>atencion_avanzada_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="atencion_avanzada_c_rec" name="File the warranty claim">
      <bpmn:incoming>atencion_avanzada_f0_0</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="atencion_avanzada_c_res" name="Receives the answer">
      <bpmn:incoming>atencion_avanzada_f0_1</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="atencion_avanzada_c_res_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="atencion_avanzada_c_fin" name="Case closed">
      <bpmn:incoming>atencion_avanzada_f0_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="atencion_avanzada_f0_0" sourceRef="atencion_avanzada_c_ini" targetRef="atencion_avanzada_c_rec" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_1" sourceRef="atencion_avanzada_c_rec" targetRef="atencion_avanzada_c_res" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_2" sourceRef="atencion_avanzada_c_res" targetRef="atencion_avanzada_c_fin" />
  </bpmn:process>
  <bpmn:process id="atencion_avanzada_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="atencion_avanzada_carriles_empresa">
      <bpmn:lane id="atencion_avanzada_carril_ate" name="Customer service">
        <bpmn:flowNodeRef>atencion_avanzada_e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_e_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_e_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_e_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_e_uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_e_avi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="atencion_avanzada_carril_log" name="Logistics">
        <bpmn:flowNodeRef>atencion_avanzada_e_ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_e_env</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_e_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_e_inf</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="atencion_avanzada_e_ini" name="Claim arrives">
      <bpmn:outgoing>atencion_avanzada_f0_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="atencion_avanzada_e_ini_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="atencion_avanzada_e_rev" name="Check the warranty">
      <bpmn:incoming>atencion_avanzada_f0_3</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="atencion_avanzada_e_dec" name="Under warranty?">
      <bpmn:incoming>atencion_avanzada_f0_4</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_5</bpmn:outgoing>
      <bpmn:outgoing>atencion_avanzada_f0_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="atencion_avanzada_e_cot" name="Quote the repair">
      <bpmn:incoming>atencion_avanzada_f0_5</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="atencion_avanzada_e_ret" name="Collect the product">
      <bpmn:incoming>atencion_avanzada_f0_6</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="atencion_avanzada_e_env" name="Send to the repair service">
      <bpmn:incoming>atencion_avanzada_f0_7</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="atencion_avanzada_e_esp" name="Wait for the diagnosis (5 days)">
      <bpmn:incoming>atencion_avanzada_f0_8</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="atencion_avanzada_e_esp_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="atencion_avanzada_e_inf" name="Technical report arrives">
      <bpmn:incoming>atencion_avanzada_f0_9</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="atencion_avanzada_e_inf_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="atencion_avanzada_e_uni">
      <bpmn:incoming>atencion_avanzada_f0_10</bpmn:incoming>
      <bpmn:incoming>atencion_avanzada_f0_11</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="atencion_avanzada_e_avi" name="Notify the client">
      <bpmn:incoming>atencion_avanzada_f0_12</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="atencion_avanzada_e_avi_def" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="atencion_avanzada_e_fin" name="Warranty closed">
      <bpmn:incoming>atencion_avanzada_f0_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="atencion_avanzada_f0_3" sourceRef="atencion_avanzada_e_ini" targetRef="atencion_avanzada_e_rev" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_4" sourceRef="atencion_avanzada_e_rev" targetRef="atencion_avanzada_e_dec" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_5" name="No" sourceRef="atencion_avanzada_e_dec" targetRef="atencion_avanzada_e_cot" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_6" name="Yes" sourceRef="atencion_avanzada_e_dec" targetRef="atencion_avanzada_e_ret" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_7" sourceRef="atencion_avanzada_e_ret" targetRef="atencion_avanzada_e_env" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_8" sourceRef="atencion_avanzada_e_env" targetRef="atencion_avanzada_e_esp" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_9" sourceRef="atencion_avanzada_e_esp" targetRef="atencion_avanzada_e_inf" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_10" sourceRef="atencion_avanzada_e_inf" targetRef="atencion_avanzada_e_uni" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_11" sourceRef="atencion_avanzada_e_cot" targetRef="atencion_avanzada_e_uni" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_12" sourceRef="atencion_avanzada_e_uni" targetRef="atencion_avanzada_e_avi" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_13" sourceRef="atencion_avanzada_e_avi" targetRef="atencion_avanzada_e_fin" />
  </bpmn:process>
  <bpmn:process id="atencion_avanzada_proceso_tecnico" isExecutable="false">
    <bpmn:laneSet id="atencion_avanzada_carriles_tecnico">
      <bpmn:lane id="atencion_avanzada_carril_tec" name="Repair service">
        <bpmn:flowNodeRef>atencion_avanzada_s_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_s_dia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_s_inf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_s_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="atencion_avanzada_s_ini" name="Receives the product">
      <bpmn:outgoing>atencion_avanzada_f0_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="atencion_avanzada_s_ini_def" />
    </bpmn:startEvent>
    <bpmn:subProcess id="atencion_avanzada_s_dia" name="Diagnosis and repair">
      <bpmn:documentation>The details are in the "Diagnosis and repair" tab.</bpmn:documentation>
      <bpmn:incoming>atencion_avanzada_f0_14</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_15</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:userTask id="atencion_avanzada_s_inf" name="Send the technical report">
      <bpmn:incoming>atencion_avanzada_f0_15</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f0_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="atencion_avanzada_s_fin" name="Repair case closed">
      <bpmn:incoming>atencion_avanzada_f0_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="atencion_avanzada_f0_14" sourceRef="atencion_avanzada_s_ini" targetRef="atencion_avanzada_s_dia" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_15" sourceRef="atencion_avanzada_s_dia" targetRef="atencion_avanzada_s_inf" />
    <bpmn:sequenceFlow id="atencion_avanzada_f0_16" sourceRef="atencion_avanzada_s_inf" targetRef="atencion_avanzada_s_fin" />
  </bpmn:process>
  <bpmn:collaboration id="atencion_avanzada_colab1">
    <bpmn:participant id="atencion_avanzada_pool_diagnostico" name="Repair service" processRef="atencion_avanzada_proceso_diagnostico" />
  </bpmn:collaboration>
  <bpmn:process id="atencion_avanzada_proceso_diagnostico" isExecutable="false">
    <bpmn:laneSet id="atencion_avanzada_carriles_diagnostico">
      <bpmn:lane id="atencion_avanzada_carril_d_tec" name="Technician">
