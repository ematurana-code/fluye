        <bpmn:flowNodeRef>atencion_avanzada_d_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_d_cam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_avanzada_d_no</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="atencion_avanzada_d_ini" name="Product arrives">
      <bpmn:outgoing>atencion_avanzada_f1_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="atencion_avanzada_d_dia" name="Diagnose the fault">
      <bpmn:incoming>atencion_avanzada_f1_0</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f1_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="atencion_avanzada_d_dec" name="Can it be repaired?">
      <bpmn:incoming>atencion_avanzada_f1_1</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f1_2</bpmn:outgoing>
      <bpmn:outgoing>atencion_avanzada_f1_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="atencion_avanzada_d_rep" name="Repair and test">
      <bpmn:incoming>atencion_avanzada_f1_2</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f1_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="atencion_avanzada_d_ok" name="Product repaired">
      <bpmn:incoming>atencion_avanzada_f1_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="atencion_avanzada_d_cam" name="Recommend a replacement">
      <bpmn:incoming>atencion_avanzada_f1_4</bpmn:incoming>
      <bpmn:outgoing>atencion_avanzada_f1_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="atencion_avanzada_d_no" name="Replacement recommended">
      <bpmn:incoming>atencion_avanzada_f1_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="atencion_avanzada_f1_0" sourceRef="atencion_avanzada_d_ini" targetRef="atencion_avanzada_d_dia" />
    <bpmn:sequenceFlow id="atencion_avanzada_f1_1" sourceRef="atencion_avanzada_d_dia" targetRef="atencion_avanzada_d_dec" />
    <bpmn:sequenceFlow id="atencion_avanzada_f1_2" name="Yes" sourceRef="atencion_avanzada_d_dec" targetRef="atencion_avanzada_d_rep" />
    <bpmn:sequenceFlow id="atencion_avanzada_f1_3" sourceRef="atencion_avanzada_d_rep" targetRef="atencion_avanzada_d_ok" />
    <bpmn:sequenceFlow id="atencion_avanzada_f1_4" name="No" sourceRef="atencion_avanzada_d_dec" targetRef="atencion_avanzada_d_cam" />
    <bpmn:sequenceFlow id="atencion_avanzada_f1_5" sourceRef="atencion_avanzada_d_cam" targetRef="atencion_avanzada_d_no" />
  </bpmn:process>
