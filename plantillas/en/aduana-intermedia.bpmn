<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="aduana_intermedia_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="aduana_intermedia_colab0">
    <bpmn:participant id="aduana_intermedia_pool_empresa" name="Importing company" processRef="aduana_intermedia_proceso_empresa" />
  </bpmn:collaboration>
  <bpmn:process id="aduana_intermedia_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="aduana_intermedia_carriles_empresa">
      <bpmn:lane id="aduana_intermedia_carril_ejec" name="Foreign trade">
        <bpmn:flowNodeRef>aduana_intermedia_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_fal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="aduana_intermedia_carril_docu" name="Documentation">
        <bpmn:flowNodeRef>aduana_intermedia_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_dc1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_din</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_env</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_can</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_par</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="aduana_intermedia_carril_finz" name="Finance">
        <bpmn:flowNodeRef>aduana_intermedia_pag</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="aduana_intermedia_carril_oper" name="Logistics">
        <bpmn:flowNodeRef>aduana_intermedia_afo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_tra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_jun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aduana_intermedia_ret</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="aduana_intermedia_ini" name="Supplier announces a shipment">
      <bpmn:outgoing>aduana_intermedia_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="aduana_intermedia_rev" name="Review the shipping documents">
      <bpmn:incoming>aduana_intermedia_f0_0</bpmn:incoming>
      <bpmn:incoming>aduana_intermedia_f0_4</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="aduana_intermedia_dc1" name="Documents complete?">
      <bpmn:incoming>aduana_intermedia_f0_1</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_2</bpmn:outgoing>
      <bpmn:outgoing>aduana_intermedia_f0_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="aduana_intermedia_fal" name="Request the missing documents">
      <bpmn:incoming>aduana_intermedia_f0_3</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="aduana_intermedia_din" name="Prepare the import declaration">
      <bpmn:documentation>The customs declaration is filled in with the invoice and transport details.</bpmn:documentation>
      <bpmn:incoming>aduana_intermedia_f0_2</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="aduana_intermedia_env" name="File the declaration with customs">
      <bpmn:incoming>aduana_intermedia_f0_5</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="aduana_intermedia_can" name="Which inspection did customs assign?">
      <bpmn:incoming>aduana_intermedia_f0_6</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_7</bpmn:outgoing>
      <bpmn:outgoing>aduana_intermedia_f0_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="aduana_intermedia_afo" name="Present the cargo for physical inspection">
      <bpmn:documentation>If customs requires a physical inspection, an officer examines the goods at the warehouse.</bpmn:documentation>
      <bpmn:incoming>aduana_intermedia_f0_7</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="aduana_intermedia_uni">
      <bpmn:incoming>aduana_intermedia_f0_8</bpmn:incoming>
      <bpmn:incoming>aduana_intermedia_f0_9</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="aduana_intermedia_par">
      <bpmn:incoming>aduana_intermedia_f0_10</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_11</bpmn:outgoing>
      <bpmn:outgoing>aduana_intermedia_f0_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="aduana_intermedia_pag" name="Pay duties and taxes">
      <bpmn:incoming>aduana_intermedia_f0_11</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="aduana_intermedia_tra" name="Arrange pickup and transport">
      <bpmn:incoming>aduana_intermedia_f0_12</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="aduana_intermedia_jun">
      <bpmn:incoming>aduana_intermedia_f0_13</bpmn:incoming>
      <bpmn:incoming>aduana_intermedia_f0_14</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="aduana_intermedia_ret" name="Pick up the cargo from the warehouse">
      <bpmn:incoming>aduana_intermedia_f0_15</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="aduana_intermedia_ent" name="Receive at the warehouse and close the file">
      <bpmn:incoming>aduana_intermedia_f0_16</bpmn:incoming>
      <bpmn:outgoing>aduana_intermedia_f0_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="aduana_intermedia_fin" name="Import completed">
      <bpmn:incoming>aduana_intermedia_f0_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="aduana_intermedia_f0_0" sourceRef="aduana_intermedia_ini" targetRef="aduana_intermedia_rev" />
    <bpmn:sequenceFlow id="aduana_intermedia_f0_1" sourceRef="aduana_intermedia_rev" targetRef="aduana_intermedia_dc1" />
    <bpmn:sequenceFlow id="aduana_intermedia_f0_2" name="Yes" sourceRef="aduana_intermedia_dc1" targetRef="aduana_intermedia_din" />
    <bpmn:sequenceFlow id="aduana_intermedia_f0_3" name="No" sourceRef="aduana_intermedia_dc1" targetRef="aduana_intermedia_fal" />
    <bpmn:sequenceFlow id="aduana_intermedia_f0_4" sourceRef="aduana_intermedia_fal" targetRef="aduana_intermedia_rev" />
