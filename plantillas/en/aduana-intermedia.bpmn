    <bpmn:sequenceFlow id="aduana_intermedia_f0_15" sourceRef="aduana_intermedia_jun" targetRef="aduana_intermedia_ret" />
    <bpmn:sequenceFlow id="aduana_intermedia_f0_16" sourceRef="aduana_intermedia_ret" targetRef="aduana_intermedia_ent" />
    <bpmn:sequenceFlow id="aduana_intermedia_f0_17" sourceRef="aduana_intermedia_ent" targetRef="aduana_intermedia_fin" />
  </bpmn:process>
