    <bpmn:sequenceFlow id="aduana_intermedia_f0_8" name="Documentary" sourceRef="aduana_intermedia_can" targetRef="aduana_intermedia_uni" />
    <bpmn:sequenceFlow id="aduana_intermedia_f0_9" sourceRef="aduana_intermedia_afo" targetRef="aduana_intermedia_uni" />
    <bpmn:sequenceFlow id="aduana_intermedia_f0_10" sourceRef="aduana_intermedia_uni" targetRef="aduana_intermedia_par" />
    <bpmn:sequenceFlow id="aduana_intermedia_f0_11" sourceRef="aduana_intermedia_par" targetRef="aduana_intermedia_pag" />
