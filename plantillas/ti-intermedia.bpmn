    <bpmn:sequenceFlow id="ti_intermedia_f0_13" sourceRef="ti_intermedia_pro" targetRef="ti_intermedia_fun" />
    <bpmn:sequenceFlow id="ti_intermedia_f0_14" name="Sí" sourceRef="ti_intermedia_fun" targetRef="ti_intermedia_cer" />
    <bpmn:sequenceFlow id="ti_intermedia_f0_15" name="No" sourceRef="ti_intermedia_fun" targetRef="ti_intermedia_rea" />
    <bpmn:sequenceFlow id="ti_intermedia_f0_16" sourceRef="ti_intermedia_rea" targetRef="ti_intermedia_int" />
    <bpmn:sequenceFlow id="ti_intermedia_f0_17" sourceRef="ti_intermedia_cer" targetRef="ti_intermedia_fin" />
  </bpmn:process>
