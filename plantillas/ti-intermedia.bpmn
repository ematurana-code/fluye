<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="ti_intermedia_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="ti_intermedia_colab0">
    <bpmn:participant id="ti_intermedia_pool_soporte" name="Soporte TI" processRef="ti_intermedia_proceso_soporte" />
  </bpmn:collaboration>
  <bpmn:process id="ti_intermedia_proceso_soporte" isExecutable="false">
    <bpmn:laneSet id="ti_intermedia_carriles_soporte">
      <bpmn:lane id="ti_intermedia_carril_usu" name="Usuario">
        <bpmn:flowNodeRef>ti_intermedia_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_cre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_pro</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ti_intermedia_carril_n1" name="Mesa de ayuda (nivel 1)">
        <bpmn:flowNodeRef>ti_intermedia_cla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_int</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_re1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_avi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_jun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_fun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_rea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_cer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ti_intermedia_carril_n2" name="Especialista (nivel 2)">
        <bpmn:flowNodeRef>ti_intermedia_dia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti_intermedia_doc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ti_intermedia_ini" name="Tiene un problema">
      <bpmn:outgoing>ti_intermedia_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ti_intermedia_cre" name="Crear el ticket">
      <bpmn:incoming>ti_intermedia_f0_0</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ti_intermedia_cla" name="Clasificar y asignar prioridad">
      <bpmn:incoming>ti_intermedia_f0_1</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ti_intermedia_int" name="Intentar la solución">
      <bpmn:incoming>ti_intermedia_f0_2</bpmn:incoming>
      <bpmn:incoming>ti_intermedia_f0_16</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ti_intermedia_re1" name="¿Se resolvió?">
      <bpmn:incoming>ti_intermedia_f0_3</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_4</bpmn:outgoing>
      <bpmn:outgoing>ti_intermedia_f0_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ti_intermedia_dia" name="Diagnosticar y resolver">
      <bpmn:incoming>ti_intermedia_f0_5</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ti_intermedia_uni">
      <bpmn:incoming>ti_intermedia_f0_4</bpmn:incoming>
      <bpmn:incoming>ti_intermedia_f0_6</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ti_intermedia_par">
      <bpmn:incoming>ti_intermedia_f0_7</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_8</bpmn:outgoing>
      <bpmn:outgoing>ti_intermedia_f0_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="ti_intermedia_avi" name="Avisar al usuario">
      <bpmn:incoming>ti_intermedia_f0_8</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ti_intermedia_doc" name="Documentar la solución">
      <bpmn:documentation>Queda en la base de conocimiento para resolver más rápido la próxima vez.</bpmn:documentation>
      <bpmn:incoming>ti_intermedia_f0_9</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ti_intermedia_jun">
      <bpmn:incoming>ti_intermedia_f0_10</bpmn:incoming>
      <bpmn:incoming>ti_intermedia_f0_11</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="ti_intermedia_pro" name="Probar la solución">
      <bpmn:incoming>ti_intermedia_f0_12</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ti_intermedia_fun" name="¿El usuario confirma que funciona?">
      <bpmn:incoming>ti_intermedia_f0_13</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_14</bpmn:outgoing>
      <bpmn:outgoing>ti_intermedia_f0_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ti_intermedia_rea" name="Reabrir el ticket">
      <bpmn:incoming>ti_intermedia_f0_15</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ti_intermedia_cer" name="Cerrar el ticket">
      <bpmn:incoming>ti_intermedia_f0_14</bpmn:incoming>
      <bpmn:outgoing>ti_intermedia_f0_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ti_intermedia_fin" name="Ticket cerrado">
      <bpmn:incoming>ti_intermedia_f0_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ti_intermedia_f0_0" sourceRef="ti_intermedia_ini" targetRef="ti_intermedia_cre" />
