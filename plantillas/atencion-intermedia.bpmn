<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="atencion_intermedia_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="atencion_intermedia_colab0">
    <bpmn:participant id="atencion_intermedia_pool_empresa" name="Empresa" processRef="atencion_intermedia_proceso_empresa" />
  </bpmn:collaboration>
  <bpmn:process id="atencion_intermedia_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="atencion_intermedia_carriles_empresa">
      <bpmn:lane id="atencion_intermedia_carril_ate" name="Atención al cliente">
        <bpmn:flowNodeRef>atencion_intermedia_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_intermedia_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_intermedia_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_intermedia_exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_intermedia_fi2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_intermedia_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_intermedia_jun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_intermedia_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_intermedia_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_intermedia_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_intermedia_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="atencion_intermedia_carril_are" name="Área responsable">
        <bpmn:flowNodeRef>atencion_intermedia_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atencion_intermedia_sol</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="atencion_intermedia_carril_cal" name="Calidad">
        <bpmn:flowNodeRef>atencion_intermedia_rca</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="atencion_intermedia_ini" name="Llega un reclamo">
      <bpmn:outgoing>atencion_intermedia_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="atencion_intermedia_reg" name="Registrar y clasificar el reclamo">
      <bpmn:incoming>atencion_intermedia_f0_0</bpmn:incoming>
      <bpmn:outgoing>atencion_intermedia_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="atencion_intermedia_val" name="¿Es un reclamo válido?">
      <bpmn:incoming>atencion_intermedia_f0_1</bpmn:incoming>
      <bpmn:outgoing>atencion_intermedia_f0_2</bpmn:outgoing>
      <bpmn:outgoing>atencion_intermedia_f0_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="atencion_intermedia_exp" name="Explicar al cliente por qué no procede">
      <bpmn:incoming>atencion_intermedia_f0_3</bpmn:incoming>
      <bpmn:outgoing>atencion_intermedia_f0_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="atencion_intermedia_fi2" name="Reclamo cerrado sin solución">
      <bpmn:incoming>atencion_intermedia_f0_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="atencion_intermedia_par">
      <bpmn:incoming>atencion_intermedia_f0_2</bpmn:incoming>
      <bpmn:outgoing>atencion_intermedia_f0_5</bpmn:outgoing>
      <bpmn:outgoing>atencion_intermedia_f0_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="atencion_intermedia_inv" name="Investigar la causa">
      <bpmn:incoming>atencion_intermedia_f0_5</bpmn:incoming>
      <bpmn:outgoing>atencion_intermedia_f0_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="atencion_intermedia_rca" name="Registrar en el informe de calidad">
      <bpmn:incoming>atencion_intermedia_f0_6</bpmn:incoming>
      <bpmn:outgoing>atencion_intermedia_f0_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="atencion_intermedia_jun">
      <bpmn:incoming>atencion_intermedia_f0_7</bpmn:incoming>
      <bpmn:incoming>atencion_intermedia_f0_8</bpmn:incoming>
      <bpmn:outgoing>atencion_intermedia_f0_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="atencion_intermedia_sol" name="Proponer una solución">
      <bpmn:incoming>atencion_intermedia_f0_9</bpmn:incoming>
      <bpmn:incoming>atencion_intermedia_f0_14</bpmn:incoming>
      <bpmn:outgoing>atencion_intermedia_f0_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="atencion_intermedia_res" name="Responder al cliente">
      <bpmn:incoming>atencion_intermedia_f0_10</bpmn:incoming>
      <bpmn:outgoing>atencion_intermedia_f0_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="atencion_intermedia_con" name="¿El cliente queda conforme?">
      <bpmn:incoming>atencion_intermedia_f0_11</bpmn:incoming>
      <bpmn:outgoing>atencion_intermedia_f0_12</bpmn:outgoing>
      <bpmn:outgoing>atencion_intermedia_f0_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="atencion_intermedia_rev" name="Revisar la solución">
      <bpmn:incoming>atencion_intermedia_f0_13</bpmn:incoming>
      <bpmn:outgoing>atencion_intermedia_f0_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="atencion_intermedia_fin" name="Reclamo resuelto">
      <bpmn:incoming>atencion_intermedia_f0_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="atencion_intermedia_f0_0" sourceRef="atencion_intermedia_ini" targetRef="atencion_intermedia_reg" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_1" sourceRef="atencion_intermedia_reg" targetRef="atencion_intermedia_val" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_2" name="Sí" sourceRef="atencion_intermedia_val" targetRef="atencion_intermedia_par" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_3" name="No" sourceRef="atencion_intermedia_val" targetRef="atencion_intermedia_exp" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_4" sourceRef="atencion_intermedia_exp" targetRef="atencion_intermedia_fi2" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_5" sourceRef="atencion_intermedia_par" targetRef="atencion_intermedia_inv" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_6" sourceRef="atencion_intermedia_par" targetRef="atencion_intermedia_rca" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_7" sourceRef="atencion_intermedia_inv" targetRef="atencion_intermedia_jun" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_8" sourceRef="atencion_intermedia_rca" targetRef="atencion_intermedia_jun" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_9" sourceRef="atencion_intermedia_jun" targetRef="atencion_intermedia_sol" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_10" sourceRef="atencion_intermedia_sol" targetRef="atencion_intermedia_res" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_11" sourceRef="atencion_intermedia_res" targetRef="atencion_intermedia_con" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_12" name="Sí" sourceRef="atencion_intermedia_con" targetRef="atencion_intermedia_fin" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_13" name="No" sourceRef="atencion_intermedia_con" targetRef="atencion_intermedia_rev" />
    <bpmn:sequenceFlow id="atencion_intermedia_f0_14" sourceRef="atencion_intermedia_rev" targetRef="atencion_intermedia_sol" />
  </bpmn:process>
