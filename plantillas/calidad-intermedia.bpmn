<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="calidad_intermedia_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="calidad_intermedia_colab0">
    <bpmn:participant id="calidad_intermedia_pool_empresa" name="Empresa" processRef="calidad_intermedia_proceso_empresa" />
  </bpmn:collaboration>
  <bpmn:process id="calidad_intermedia_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="calidad_intermedia_carriles_empresa">
      <bpmn:lane id="calidad_intermedia_carril_cal" name="Calidad">
        <bpmn:flowNodeRef>calidad_intermedia_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_intermedia_ver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_intermedia_efi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_intermedia_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_intermedia_cer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_intermedia_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="calidad_intermedia_carril_res" name="Área responsable">
        <bpmn:flowNodeRef>calidad_intermedia_ana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_intermedia_pla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_intermedia_cor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_intermedia_jun</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="calidad_intermedia_carril_ger" name="Gerencia">
        <bpmn:flowNodeRef>calidad_intermedia_apr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_intermedia_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calidad_intermedia_cap</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="calidad_intermedia_ini" name="No conformidad registrada">
      <bpmn:outgoing>calidad_intermedia_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="calidad_intermedia_ana" name="Analizar la causa raíz">
      <bpmn:documentation>Por ejemplo con los 5 porqués o un diagrama de Ishikawa.</bpmn:documentation>
      <bpmn:incoming>calidad_intermedia_f0_0</bpmn:incoming>
      <bpmn:incoming>calidad_intermedia_f0_12</bpmn:incoming>
      <bpmn:outgoing>calidad_intermedia_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="calidad_intermedia_pla" name="Definir el plan de acción">
      <bpmn:incoming>calidad_intermedia_f0_1</bpmn:incoming>
      <bpmn:outgoing>calidad_intermedia_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="calidad_intermedia_apr" name="Aprobar el plan">
      <bpmn:incoming>calidad_intermedia_f0_2</bpmn:incoming>
      <bpmn:outgoing>calidad_intermedia_f0_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="calidad_intermedia_par">
      <bpmn:incoming>calidad_intermedia_f0_3</bpmn:incoming>
      <bpmn:outgoing>calidad_intermedia_f0_4</bpmn:outgoing>
      <bpmn:outgoing>calidad_intermedia_f0_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="calidad_intermedia_cor" name="Aplicar la corrección">
      <bpmn:incoming>calidad_intermedia_f0_4</bpmn:incoming>
      <bpmn:outgoing>calidad_intermedia_f0_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="calidad_intermedia_cap" name="Capacitar al equipo">
      <bpmn:incoming>calidad_intermedia_f0_5</bpmn:incoming>
      <bpmn:outgoing>calidad_intermedia_f0_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="calidad_intermedia_jun">
      <bpmn:incoming>calidad_intermedia_f0_6</bpmn:incoming>
      <bpmn:incoming>calidad_intermedia_f0_7</bpmn:incoming>
      <bpmn:outgoing>calidad_intermedia_f0_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="calidad_intermedia_ver" name="Verificar la eficacia">
      <bpmn:incoming>calidad_intermedia_f0_8</bpmn:incoming>
      <bpmn:outgoing>calidad_intermedia_f0_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="calidad_intermedia_efi" name="¿Se eliminó el problema?">
      <bpmn:incoming>calidad_intermedia_f0_9</bpmn:incoming>
      <bpmn:outgoing>calidad_intermedia_f0_10</bpmn:outgoing>
      <bpmn:outgoing>calidad_intermedia_f0_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="calidad_intermedia_rev" name="Revisar el análisis">
      <bpmn:incoming>calidad_intermedia_f0_11</bpmn:incoming>
      <bpmn:outgoing>calidad_intermedia_f0_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="calidad_intermedia_cer" name="Cerrar la acción correctiva">
      <bpmn:incoming>calidad_intermedia_f0_10</bpmn:incoming>
      <bpmn:outgoing>calidad_intermedia_f0_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="calidad_intermedia_fin" name="Acción cerrada">
      <bpmn:incoming>calidad_intermedia_f0_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="calidad_intermedia_f0_0" sourceRef="calidad_intermedia_ini" targetRef="calidad_intermedia_ana" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_1" sourceRef="calidad_intermedia_ana" targetRef="calidad_intermedia_pla" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_2" sourceRef="calidad_intermedia_pla" targetRef="calidad_intermedia_apr" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_3" sourceRef="calidad_intermedia_apr" targetRef="calidad_intermedia_par" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_4" sourceRef="calidad_intermedia_par" targetRef="calidad_intermedia_cor" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_5" sourceRef="calidad_intermedia_par" targetRef="calidad_intermedia_cap" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_6" sourceRef="calidad_intermedia_cor" targetRef="calidad_intermedia_jun" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_7" sourceRef="calidad_intermedia_cap" targetRef="calidad_intermedia_jun" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_8" sourceRef="calidad_intermedia_jun" targetRef="calidad_intermedia_ver" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_9" sourceRef="calidad_intermedia_ver" targetRef="calidad_intermedia_efi" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_10" name="Sí" sourceRef="calidad_intermedia_efi" targetRef="calidad_intermedia_cer" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_11" name="No" sourceRef="calidad_intermedia_efi" targetRef="calidad_intermedia_rev" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_12" sourceRef="calidad_intermedia_rev" targetRef="calidad_intermedia_ana" />
    <bpmn:sequenceFlow id="calidad_intermedia_f0_13" sourceRef="calidad_intermedia_cer" targetRef="calidad_intermedia_fin" />
  </bpmn:process>
