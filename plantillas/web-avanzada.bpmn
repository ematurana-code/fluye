      </bpmn:lane>
      <bpmn:lane id="web_avanzada_carril_l_web" name="Sitio web">
        <bpmn:flowNodeRef>web_avanzada_l_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_l_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_l_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="web_avanzada_l_ini" name="Entra a la tienda">
      <bpmn:outgoing>web_avanzada_f1_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="web_avanzada_l_ing" name="Ingresar correo y contraseña">
      <bpmn:incoming>web_avanzada_f1_0</bpmn:incoming>
      <bpmn:incoming>web_avanzada_f1_5</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f1_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="web_avanzada_l_val" name="Validar las credenciales">
      <bpmn:incoming>web_avanzada_f1_1</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f1_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="web_avanzada_l_dec" name="¿Son correctas?">
      <bpmn:incoming>web_avanzada_f1_2</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f1_3</bpmn:outgoing>
      <bpmn:outgoing>web_avanzada_f1_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="web_avanzada_l_ok" name="Sesión iniciada">
      <bpmn:incoming>web_avanzada_f1_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="web_avanzada_l_err" name="Mostrar mensaje de error">
      <bpmn:incoming>web_avanzada_f1_4</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f1_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="web_avanzada_f1_0" sourceRef="web_avanzada_l_ini" targetRef="web_avanzada_l_ing" />
    <bpmn:sequenceFlow id="web_avanzada_f1_1" sourceRef="web_avanzada_l_ing" targetRef="web_avanzada_l_val" />
    <bpmn:sequenceFlow id="web_avanzada_f1_2" sourceRef="web_avanzada_l_val" targetRef="web_avanzada_l_dec" />
    <bpmn:sequenceFlow id="web_avanzada_f1_3" name="Sí" sourceRef="web_avanzada_l_dec" targetRef="web_avanzada_l_ok" />
    <bpmn:sequenceFlow id="web_avanzada_f1_4" name="No" sourceRef="web_avanzada_l_dec" targetRef="web_avanzada_l_err" />
    <bpmn:sequenceFlow id="web_avanzada_f1_5" sourceRef="web_avanzada_l_err" targetRef="web_avanzada_l_ing" />
  </bpmn:process>
