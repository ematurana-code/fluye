<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="web_avanzada_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="web_avanzada_colab0">
    <bpmn:participant id="web_avanzada_pool_cliente" name="Cliente" processRef="web_avanzada_proceso_cliente" />
    <bpmn:participant id="web_avanzada_pool_tienda" name="Tienda web" processRef="web_avanzada_proceso_tienda" />
    <bpmn:participant id="web_avanzada_pool_pasarela" name="Pasarela de pago" processRef="web_avanzada_proceso_pasarela" />
    <bpmn:messageFlow id="web_avanzada_m0_0" name="Pedido" sourceRef="web_avanzada_c_car" targetRef="web_avanzada_w_ini" />
    <bpmn:messageFlow id="web_avanzada_m0_1" name="Página de pago" sourceRef="web_avanzada_w_red" targetRef="web_avanzada_c_red" />
    <bpmn:messageFlow id="web_avanzada_m0_2" name="Datos de la tarjeta" sourceRef="web_avanzada_c_pag" targetRef="web_avanzada_p_ini" />
    <bpmn:messageFlow id="web_avanzada_m0_3" name="Resultado del pago" sourceRef="web_avanzada_p_res" targetRef="web_avanzada_w_res" />
    <bpmn:messageFlow id="web_avanzada_m0_4" name="Resultado" sourceRef="web_avanzada_w_avi" targetRef="web_avanzada_c_res" />
  </bpmn:collaboration>
  <bpmn:process id="web_avanzada_proceso_cliente" isExecutable="false">
    <bpmn:laneSet id="web_avanzada_carriles_cliente">
      <bpmn:lane id="web_avanzada_carril_cli" name="Cliente">
        <bpmn:flowNodeRef>web_avanzada_c_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_c_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_c_car</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_c_red</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_c_pag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_c_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_c_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="web_avanzada_c_ini" name="Quiere comprar en línea">
      <bpmn:outgoing>web_avanzada_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="web_avanzada_c_log" name="Iniciar sesión">
      <bpmn:documentation>El detalle está en la pestaña "Iniciar sesión".</bpmn:documentation>
      <bpmn:incoming>web_avanzada_f0_0</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_1</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:userTask id="web_avanzada_c_car" name="Armar el carro y confirmar la compra">
      <bpmn:incoming>web_avanzada_f0_1</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="web_avanzada_c_red" name="Llega a la página de pago">
      <bpmn:incoming>web_avanzada_f0_2</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="web_avanzada_c_red_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="web_avanzada_c_pag" name="Ingresar los datos de la tarjeta">
      <bpmn:incoming>web_avanzada_f0_3</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="web_avanzada_c_res" name="Recibe el resultado de la compra">
      <bpmn:incoming>web_avanzada_f0_4</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="web_avanzada_c_res_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="web_avanzada_c_fin" name="Compra terminada">
      <bpmn:incoming>web_avanzada_f0_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="web_avanzada_f0_0" sourceRef="web_avanzada_c_ini" targetRef="web_avanzada_c_log" />
    <bpmn:sequenceFlow id="web_avanzada_f0_1" sourceRef="web_avanzada_c_log" targetRef="web_avanzada_c_car" />
    <bpmn:sequenceFlow id="web_avanzada_f0_2" sourceRef="web_avanzada_c_car" targetRef="web_avanzada_c_red" />
    <bpmn:sequenceFlow id="web_avanzada_f0_3" sourceRef="web_avanzada_c_red" targetRef="web_avanzada_c_pag" />
    <bpmn:sequenceFlow id="web_avanzada_f0_4" sourceRef="web_avanzada_c_pag" targetRef="web_avanzada_c_res" />
    <bpmn:sequenceFlow id="web_avanzada_f0_5" sourceRef="web_avanzada_c_res" targetRef="web_avanzada_c_fin" />
  </bpmn:process>
  <bpmn:process id="web_avanzada_proceso_tienda" isExecutable="false">
    <bpmn:laneSet id="web_avanzada_carriles_tienda">
      <bpmn:lane id="web_avanzada_carril_web" name="Sitio web">
        <bpmn:flowNodeRef>web_avanzada_w_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_w_red</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_w_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_w_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_w_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_w_anu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_w_uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_w_avi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_w_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="web_avanzada_carril_bod" name="Bodega">
        <bpmn:flowNodeRef>web_avanzada_w_pre</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="web_avanzada_w_ini" name="Recibe el pedido">
      <bpmn:outgoing>web_avanzada_f0_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="web_avanzada_w_ini_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="web_avanzada_w_red" name="Redirigir a la pasarela de pago">
      <bpmn:incoming>web_avanzada_f0_6</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="web_avanzada_w_esp" name="Plazo para pagar (15 minutos)">
      <bpmn:incoming>web_avanzada_f0_7</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="web_avanzada_w_esp_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="web_avanzada_w_res" name="Llega el resultado del pago">
      <bpmn:incoming>web_avanzada_f0_8</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="web_avanzada_w_res_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="web_avanzada_w_dec" name="¿Pago aprobado?">
      <bpmn:incoming>web_avanzada_f0_9</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_10</bpmn:outgoing>
      <bpmn:outgoing>web_avanzada_f0_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="web_avanzada_w_anu" name="Anular el pedido y liberar el stock">
      <bpmn:incoming>web_avanzada_f0_11</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="web_avanzada_w_pre" name="Preparar el despacho">
      <bpmn:incoming>web_avanzada_f0_10</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="web_avanzada_w_uni">
      <bpmn:incoming>web_avanzada_f0_12</bpmn:incoming>
      <bpmn:incoming>web_avanzada_f0_13</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="web_avanzada_w_avi" name="Avisar el resultado al cliente">
      <bpmn:incoming>web_avanzada_f0_14</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="web_avanzada_w_avi_def" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="web_avanzada_w_fin" name="Pedido procesado">
      <bpmn:incoming>web_avanzada_f0_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="web_avanzada_f0_6" sourceRef="web_avanzada_w_ini" targetRef="web_avanzada_w_red" />
    <bpmn:sequenceFlow id="web_avanzada_f0_7" sourceRef="web_avanzada_w_red" targetRef="web_avanzada_w_esp" />
    <bpmn:sequenceFlow id="web_avanzada_f0_8" sourceRef="web_avanzada_w_esp" targetRef="web_avanzada_w_res" />
    <bpmn:sequenceFlow id="web_avanzada_f0_9" sourceRef="web_avanzada_w_res" targetRef="web_avanzada_w_dec" />
    <bpmn:sequenceFlow id="web_avanzada_f0_10" name="Sí" sourceRef="web_avanzada_w_dec" targetRef="web_avanzada_w_pre" />
    <bpmn:sequenceFlow id="web_avanzada_f0_11" name="No" sourceRef="web_avanzada_w_dec" targetRef="web_avanzada_w_anu" />
    <bpmn:sequenceFlow id="web_avanzada_f0_12" sourceRef="web_avanzada_w_anu" targetRef="web_avanzada_w_uni" />
    <bpmn:sequenceFlow id="web_avanzada_f0_13" sourceRef="web_avanzada_w_pre" targetRef="web_avanzada_w_uni" />
    <bpmn:sequenceFlow id="web_avanzada_f0_14" sourceRef="web_avanzada_w_uni" targetRef="web_avanzada_w_avi" />
    <bpmn:sequenceFlow id="web_avanzada_f0_15" sourceRef="web_avanzada_w_avi" targetRef="web_avanzada_w_fin" />
  </bpmn:process>
  <bpmn:process id="web_avanzada_proceso_pasarela" isExecutable="false">
    <bpmn:laneSet id="web_avanzada_carriles_pasarela">
      <bpmn:lane id="web_avanzada_carril_pas" name="Pasarela de pago">
        <bpmn:flowNodeRef>web_avanzada_p_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_p_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_p_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web_avanzada_p_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="web_avanzada_p_ini" name="Recibe los datos de la tarjeta">
      <bpmn:outgoing>web_avanzada_f0_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="web_avanzada_p_ini_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="web_avanzada_p_val" name="Validar con el banco emisor">
      <bpmn:incoming>web_avanzada_f0_16</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="web_avanzada_p_res" name="Informar el resultado a la tienda">
      <bpmn:incoming>web_avanzada_f0_17</bpmn:incoming>
      <bpmn:outgoing>web_avanzada_f0_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="web_avanzada_p_fin" name="Pago procesado">
      <bpmn:incoming>web_avanzada_f0_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="web_avanzada_f0_16" sourceRef="web_avanzada_p_ini" targetRef="web_avanzada_p_val" />
    <bpmn:sequenceFlow id="web_avanzada_f0_17" sourceRef="web_avanzada_p_val" targetRef="web_avanzada_p_res" />
    <bpmn:sequenceFlow id="web_avanzada_f0_18" sourceRef="web_avanzada_p_res" targetRef="web_avanzada_p_fin" />
  </bpmn:process>
  <bpmn:collaboration id="web_avanzada_colab1">
    <bpmn:participant id="web_avanzada_pool_login" name="Inicio de sesión" processRef="web_avanzada_proceso_login" />
  </bpmn:collaboration>
  <bpmn:process id="web_avanzada_proceso_login" isExecutable="false">
    <bpmn:laneSet id="web_avanzada_carriles_login">
      <bpmn:lane id="web_avanzada_carril_l_usu" name="Cliente">
        <bpmn:flowNodeRef>web_avanzada_l_ini</bpmn:flowNodeRef>
