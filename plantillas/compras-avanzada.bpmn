<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="compras_avanzada_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="compras_avanzada_colab0">
    <bpmn:participant id="compras_avanzada_pool_empresa" name="Empresa" processRef="compras_avanzada_proceso_empresa" />
    <bpmn:participant id="compras_avanzada_pool_proveedor" name="Proveedor" processRef="compras_avanzada_proceso_proveedor" />
    <bpmn:messageFlow id="compras_avanzada_m0_0" name="Orden de compra" sourceRef="compras_avanzada_e_oc" targetRef="compras_avanzada_p_ini" />
    <bpmn:messageFlow id="compras_avanzada_m0_1" name="Mercadería y guía" sourceRef="compras_avanzada_p_des" targetRef="compras_avanzada_e_lle" />
    <bpmn:messageFlow id="compras_avanzada_m0_2" name="Factura" sourceRef="compras_avanzada_p_fac" targetRef="compras_avanzada_e_fac" />
    <bpmn:messageFlow id="compras_avanzada_m0_3" name="Pago" sourceRef="compras_avanzada_e_pag" targetRef="compras_avanzada_p_cob" />
  </bpmn:collaboration>
  <bpmn:process id="compras_avanzada_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="compras_avanzada_carriles_empresa">
      <bpmn:lane id="compras_avanzada_carril_cmp" name="Compras">
        <bpmn:flowNodeRef>compras_avanzada_e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_e_lic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_e_oc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_e_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_e_dif</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compras_avanzada_carril_bod" name="Bodega">
        <bpmn:flowNodeRef>compras_avanzada_e_lle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_e_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_e_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_e_uni</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compras_avanzada_carril_fnz" name="Finanzas">
        <bpmn:flowNodeRef>compras_avanzada_e_fac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_e_pag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="compras_avanzada_e_ini" name="Compra aprobada">
      <bpmn:outgoing>compras_avanzada_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="compras_avanzada_e_lic" name="Licitación">
      <bpmn:documentation>El detalle está en la pestaña "Licitación".</bpmn:documentation>
      <bpmn:incoming>compras_avanzada_f0_0</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_1</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:userTask id="compras_avanzada_e_oc" name="Enviar la orden de compra">
      <bpmn:incoming>compras_avanzada_f0_1</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="compras_avanzada_e_esp" name="Esperar el despacho (plazo pactado)">
      <bpmn:incoming>compras_avanzada_f0_2</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="compras_avanzada_e_esp_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="compras_avanzada_e_lle" name="Llega la mercadería y la guía">
      <bpmn:incoming>compras_avanzada_f0_3</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="compras_avanzada_e_lle_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="compras_avanzada_e_rev" name="Revisar la mercadería">
      <bpmn:incoming>compras_avanzada_f0_4</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="compras_avanzada_e_con" name="¿Llegó conforme?">
      <bpmn:incoming>compras_avanzada_f0_5</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_6</bpmn:outgoing>
      <bpmn:outgoing>compras_avanzada_f0_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="compras_avanzada_e_dif" name="Registrar la diferencia">
      <bpmn:incoming>compras_avanzada_f0_7</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="compras_avanzada_e_uni">
      <bpmn:incoming>compras_avanzada_f0_6</bpmn:incoming>
      <bpmn:incoming>compras_avanzada_f0_8</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="compras_avanzada_e_fac" name="Llega la factura">
      <bpmn:incoming>compras_avanzada_f0_9</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="compras_avanzada_e_fac_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="compras_avanzada_e_pag" name="Pagar la factura">
      <bpmn:incoming>compras_avanzada_f0_10</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="compras_avanzada_e_fin" name="Compra pagada">
      <bpmn:incoming>compras_avanzada_f0_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="compras_avanzada_f0_0" sourceRef="compras_avanzada_e_ini" targetRef="compras_avanzada_e_lic" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_1" sourceRef="compras_avanzada_e_lic" targetRef="compras_avanzada_e_oc" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_2" sourceRef="compras_avanzada_e_oc" targetRef="compras_avanzada_e_esp" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_3" sourceRef="compras_avanzada_e_esp" targetRef="compras_avanzada_e_lle" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_4" sourceRef="compras_avanzada_e_lle" targetRef="compras_avanzada_e_rev" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_5" sourceRef="compras_avanzada_e_rev" targetRef="compras_avanzada_e_con" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_6" name="Sí" sourceRef="compras_avanzada_e_con" targetRef="compras_avanzada_e_uni" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_7" name="No" sourceRef="compras_avanzada_e_con" targetRef="compras_avanzada_e_dif" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_8" sourceRef="compras_avanzada_e_dif" targetRef="compras_avanzada_e_uni" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_9" sourceRef="compras_avanzada_e_uni" targetRef="compras_avanzada_e_fac" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_10" sourceRef="compras_avanzada_e_fac" targetRef="compras_avanzada_e_pag" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_11" sourceRef="compras_avanzada_e_pag" targetRef="compras_avanzada_e_fin" />
  </bpmn:process>
  <bpmn:process id="compras_avanzada_proceso_proveedor" isExecutable="false">
    <bpmn:laneSet id="compras_avanzada_carriles_proveedor">
      <bpmn:lane id="compras_avanzada_carril_prv" name="Proveedor">
        <bpmn:flowNodeRef>compras_avanzada_p_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_p_pre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_p_des</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_p_fac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_p_cob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_p_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="compras_avanzada_p_ini" name="Recibe la orden de compra">
      <bpmn:outgoing>compras_avanzada_f0_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="compras_avanzada_p_ini_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="compras_avanzada_p_pre" name="Preparar el pedido">
      <bpmn:incoming>compras_avanzada_f0_12</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="compras_avanzada_p_des" name="Despachar con guía">
      <bpmn:incoming>compras_avanzada_f0_13</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="compras_avanzada_p_fac" name="Emitir la factura">
      <bpmn:incoming>compras_avanzada_f0_14</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="compras_avanzada_p_cob" name="Recibe el pago">
      <bpmn:incoming>compras_avanzada_f0_15</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f0_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="compras_avanzada_p_cob_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="compras_avanzada_p_fin" name="Venta cobrada">
      <bpmn:incoming>compras_avanzada_f0_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="compras_avanzada_f0_12" sourceRef="compras_avanzada_p_ini" targetRef="compras_avanzada_p_pre" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_13" sourceRef="compras_avanzada_p_pre" targetRef="compras_avanzada_p_des" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_14" sourceRef="compras_avanzada_p_des" targetRef="compras_avanzada_p_fac" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_15" sourceRef="compras_avanzada_p_fac" targetRef="compras_avanzada_p_cob" />
    <bpmn:sequenceFlow id="compras_avanzada_f0_16" sourceRef="compras_avanzada_p_cob" targetRef="compras_avanzada_p_fin" />
  </bpmn:process>
  <bpmn:collaboration id="compras_avanzada_colab1">
    <bpmn:participant id="compras_avanzada_pool_licitacion" name="Licitación" processRef="compras_avanzada_proceso_licitacion" />
  </bpmn:collaboration>
  <bpmn:process id="compras_avanzada_proceso_licitacion" isExecutable="false">
    <bpmn:laneSet id="compras_avanzada_carriles_licitacion">
      <bpmn:lane id="compras_avanzada_carril_l_cmp" name="Compras">
        <bpmn:flowNodeRef>compras_avanzada_l_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_l_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_l_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_l_amp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compras_avanzada_carril_l_jef" name="Jefatura">
        <bpmn:flowNodeRef>compras_avanzada_l_eva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_l_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compras_avanzada_l_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="compras_avanzada_l_ini" name="Se necesita un proveedor">
      <bpmn:outgoing>compras_avanzada_f1_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="compras_avanzada_l_inv" name="Invitar a proveedores">
      <bpmn:incoming>compras_avanzada_f1_0</bpmn:incoming>
      <bpmn:incoming>compras_avanzada_f1_6</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f1_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="compras_avanzada_l_esp" name="Plazo para recibir ofertas (5 días)">
      <bpmn:incoming>compras_avanzada_f1_1</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f1_2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="compras_avanzada_l_esp_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="compras_avanzada_l_eva" name="Evaluar las ofertas">
      <bpmn:incoming>compras_avanzada_f1_2</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f1_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="compras_avanzada_l_dec" name="¿Hay una oferta válida?">
      <bpmn:incoming>compras_avanzada_f1_3</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f1_4</bpmn:outgoing>
      <bpmn:outgoing>compras_avanzada_f1_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="compras_avanzada_l_ok" name="Proveedor elegido">
      <bpmn:incoming>compras_avanzada_f1_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="compras_avanzada_l_amp" name="Ampliar la invitación">
      <bpmn:incoming>compras_avanzada_f1_5</bpmn:incoming>
      <bpmn:outgoing>compras_avanzada_f1_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="compras_avanzada_f1_0" sourceRef="compras_avanzada_l_ini" targetRef="compras_avanzada_l_inv" />
    <bpmn:sequenceFlow id="compras_avanzada_f1_1" sourceRef="compras_avanzada_l_inv" targetRef="compras_avanzada_l_esp" />
    <bpmn:sequenceFlow id="compras_avanzada_f1_2" sourceRef="compras_avanzada_l_esp" targetRef="compras_avanzada_l_eva" />
    <bpmn:sequenceFlow id="compras_avanzada_f1_3" sourceRef="compras_avanzada_l_eva" targetRef="compras_avanzada_l_dec" />
    <bpmn:sequenceFlow id="compras_avanzada_f1_4" name="Sí" sourceRef="compras_avanzada_l_dec" targetRef="compras_avanzada_l_ok" />
    <bpmn:sequenceFlow id="compras_avanzada_f1_5" name="No" sourceRef="compras_avanzada_l_dec" targetRef="compras_avanzada_l_amp" />
    <bpmn:sequenceFlow id="compras_avanzada_f1_6" sourceRef="compras_avanzada_l_amp" targetRef="compras_avanzada_l_inv" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="compras_avanzada_diagrama0" name="Compra">
    <bpmndi:BPMNPlane id="compras_avanzada_plano0" bpmnElement="compras_avanzada_colab0">
