<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="ventas_avanzada_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="ventas_avanzada_colab0">
    <bpmn:participant id="ventas_avanzada_pool_cliente" name="Cliente" processRef="ventas_avanzada_proceso_cliente" />
    <bpmn:participant id="ventas_avanzada_pool_empresa" name="Empresa" processRef="ventas_avanzada_proceso_empresa" />
    <bpmn:participant id="ventas_avanzada_pool_transporte" name="Transporte" processRef="ventas_avanzada_proceso_transporte" />
    <bpmn:messageFlow id="ventas_avanzada_m0_0" name="Solicitud" sourceRef="ventas_avanzada_c_sol" targetRef="ventas_avanzada_e_ini" />
    <bpmn:messageFlow id="ventas_avanzada_m0_1" name="Cotización" sourceRef="ventas_avanzada_e_cot" targetRef="ventas_avanzada_c_rec" />
    <bpmn:messageFlow id="ventas_avanzada_m0_2" name="Respuesta" sourceRef="ventas_avanzada_c_res" targetRef="ventas_avanzada_e_res" />
    <bpmn:messageFlow id="ventas_avanzada_m0_3" name="Carga" sourceRef="ventas_avanzada_e_des" targetRef="ventas_avanzada_t_ini" />
    <bpmn:messageFlow id="ventas_avanzada_m0_4" name="Pedido" sourceRef="ventas_avanzada_t_ent" targetRef="ventas_avanzada_c_ped" />
    <bpmn:messageFlow id="ventas_avanzada_m0_5" name="Confirmación" sourceRef="ventas_avanzada_t_con" targetRef="ventas_avanzada_e_con" />
  </bpmn:collaboration>
  <bpmn:process id="ventas_avanzada_proceso_cliente" isExecutable="false">
    <bpmn:laneSet id="ventas_avanzada_carriles_cliente">
      <bpmn:lane id="ventas_avanzada_carril_cli" name="Cliente">
        <bpmn:flowNodeRef>ventas_avanzada_c_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_c_sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_c_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_c_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_c_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_c_ped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_c_gui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_c_fi2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ventas_avanzada_c_ini" name="Necesita un producto">
      <bpmn:outgoing>ventas_avanzada_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ventas_avanzada_c_sol" name="Pedir una cotización">
      <bpmn:incoming>ventas_avanzada_f0_0</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="ventas_avanzada_c_rec" name="Recibe la cotización">
      <bpmn:incoming>ventas_avanzada_f0_1</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ventas_avanzada_c_rec_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="ventas_avanzada_c_res" name="Responder si acepta">
      <bpmn:incoming>ventas_avanzada_f0_2</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ventas_avanzada_c_fin" name="Respuesta enviada">
      <bpmn:incoming>ventas_avanzada_f0_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ventas_avanzada_c_ped" name="Recibe el pedido">
      <bpmn:outgoing>ventas_avanzada_f0_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ventas_avanzada_c_ped_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="ventas_avanzada_c_gui" name="Firmar la guía de recepción">
      <bpmn:incoming>ventas_avanzada_f0_4</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ventas_avanzada_c_fi2" name="Pedido recibido">
      <bpmn:incoming>ventas_avanzada_f0_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ventas_avanzada_f0_0" sourceRef="ventas_avanzada_c_ini" targetRef="ventas_avanzada_c_sol" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_1" sourceRef="ventas_avanzada_c_sol" targetRef="ventas_avanzada_c_rec" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_2" sourceRef="ventas_avanzada_c_rec" targetRef="ventas_avanzada_c_res" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_3" sourceRef="ventas_avanzada_c_res" targetRef="ventas_avanzada_c_fin" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_4" sourceRef="ventas_avanzada_c_ped" targetRef="ventas_avanzada_c_gui" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_5" sourceRef="ventas_avanzada_c_gui" targetRef="ventas_avanzada_c_fi2" />
  </bpmn:process>
  <bpmn:process id="ventas_avanzada_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="ventas_avanzada_carriles_empresa">
      <bpmn:lane id="ventas_avanzada_carril_ven" name="Ventas">
        <bpmn:flowNodeRef>ventas_avanzada_e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_e_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_e_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_e_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_e_per</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ventas_avanzada_carril_bod" name="Bodega">
        <bpmn:flowNodeRef>ventas_avanzada_e_pre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_e_des</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_e_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_e_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ventas_avanzada_carril_fct" name="Facturación">
        <bpmn:flowNodeRef>ventas_avanzada_e_fac</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ventas_avanzada_e_ini" name="Llega la solicitud">
      <bpmn:outgoing>ventas_avanzada_f0_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ventas_avanzada_e_ini_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="ventas_avanzada_e_cot" name="Cotizar y enviar">
      <bpmn:incoming>ventas_avanzada_f0_6</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="ventas_avanzada_e_res" name="Llega la respuesta">
      <bpmn:incoming>ventas_avanzada_f0_7</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ventas_avanzada_e_res_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="ventas_avanzada_e_dec" name="¿Aceptó?">
      <bpmn:incoming>ventas_avanzada_f0_8</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_9</bpmn:outgoing>
      <bpmn:outgoing>ventas_avanzada_f0_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ventas_avanzada_e_per" name="Venta perdida">
      <bpmn:incoming>ventas_avanzada_f0_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="ventas_avanzada_e_pre" name="Preparar el pedido">
      <bpmn:documentation>El detalle está en la pestaña "Preparar el pedido".</bpmn:documentation>
      <bpmn:incoming>ventas_avanzada_f0_10</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_11</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:userTask id="ventas_avanzada_e_fac" name="Emitir la factura y la guía">
      <bpmn:incoming>ventas_avanzada_f0_11</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ventas_avanzada_e_des" name="Entregar al transporte">
      <bpmn:incoming>ventas_avanzada_f0_12</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="ventas_avanzada_e_esp" name="Esperar la entrega (48 horas)">
      <bpmn:incoming>ventas_avanzada_f0_13</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ventas_avanzada_e_esp_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ventas_avanzada_e_con" name="Llega la confirmación de entrega">
      <bpmn:incoming>ventas_avanzada_f0_14</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ventas_avanzada_e_con_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ventas_avanzada_e_fin" name="Venta cerrada">
      <bpmn:incoming>ventas_avanzada_f0_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ventas_avanzada_f0_6" sourceRef="ventas_avanzada_e_ini" targetRef="ventas_avanzada_e_cot" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_7" sourceRef="ventas_avanzada_e_cot" targetRef="ventas_avanzada_e_res" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_8" sourceRef="ventas_avanzada_e_res" targetRef="ventas_avanzada_e_dec" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_9" name="No" sourceRef="ventas_avanzada_e_dec" targetRef="ventas_avanzada_e_per" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_10" name="Sí" sourceRef="ventas_avanzada_e_dec" targetRef="ventas_avanzada_e_pre" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_11" sourceRef="ventas_avanzada_e_pre" targetRef="ventas_avanzada_e_fac" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_12" sourceRef="ventas_avanzada_e_fac" targetRef="ventas_avanzada_e_des" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_13" sourceRef="ventas_avanzada_e_des" targetRef="ventas_avanzada_e_esp" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_14" sourceRef="ventas_avanzada_e_esp" targetRef="ventas_avanzada_e_con" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_15" sourceRef="ventas_avanzada_e_con" targetRef="ventas_avanzada_e_fin" />
  </bpmn:process>
  <bpmn:process id="ventas_avanzada_proceso_transporte" isExecutable="false">
    <bpmn:laneSet id="ventas_avanzada_carriles_transporte">
      <bpmn:lane id="ventas_avanzada_carril_tra" name="Transporte">
        <bpmn:flowNodeRef>ventas_avanzada_t_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_t_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_t_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ventas_avanzada_t_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ventas_avanzada_t_ini" name="Recibe la carga">
      <bpmn:outgoing>ventas_avanzada_f0_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ventas_avanzada_t_ini_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="ventas_avanzada_t_ent" name="Llevar y entregar al cliente">
      <bpmn:incoming>ventas_avanzada_f0_16</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ventas_avanzada_t_con" name="Confirmar la entrega">
      <bpmn:incoming>ventas_avanzada_f0_17</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f0_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ventas_avanzada_t_fin" name="Entrega hecha">
      <bpmn:incoming>ventas_avanzada_f0_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ventas_avanzada_f0_16" sourceRef="ventas_avanzada_t_ini" targetRef="ventas_avanzada_t_ent" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_17" sourceRef="ventas_avanzada_t_ent" targetRef="ventas_avanzada_t_con" />
    <bpmn:sequenceFlow id="ventas_avanzada_f0_18" sourceRef="ventas_avanzada_t_con" targetRef="ventas_avanzada_t_fin" />
  </bpmn:process>
  <bpmn:collaboration id="ventas_avanzada_colab1">
    <bpmn:participant id="ventas_avanzada_pool_preparacion" name="Preparar el pedido" processRef="ventas_avanzada_proceso_preparacion" />
  </bpmn:collaboration>
  <bpmn:process id="ventas_avanzada_proceso_preparacion" isExecutable="false">
