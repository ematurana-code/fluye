      <bpmn:outgoing>ventas_avanzada_f1_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="ventas_avanzada_f1_0" sourceRef="ventas_avanzada_p_ini" targetRef="ventas_avanzada_p_bus" />
    <bpmn:sequenceFlow id="ventas_avanzada_f1_1" sourceRef="ventas_avanzada_p_bus" targetRef="ventas_avanzada_p_dec" />
    <bpmn:sequenceFlow id="ventas_avanzada_f1_2" name="Sí" sourceRef="ventas_avanzada_p_dec" targetRef="ventas_avanzada_p_emb" />
    <bpmn:sequenceFlow id="ventas_avanzada_f1_3" name="No" sourceRef="ventas_avanzada_p_dec" targetRef="ventas_avanzada_p_rep" />
    <bpmn:sequenceFlow id="ventas_avanzada_f1_4" sourceRef="ventas_avanzada_p_rep" targetRef="ventas_avanzada_p_bus" />
    <bpmn:sequenceFlow id="ventas_avanzada_f1_5" sourceRef="ventas_avanzada_p_emb" targetRef="ventas_avanzada_p_fin" />
  </bpmn:process>
