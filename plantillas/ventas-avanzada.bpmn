    </bpmn:startEvent>
    <bpmn:userTask id="ventas_avanzada_p_bus" name="Buscar los productos">
      <bpmn:incoming>ventas_avanzada_f1_0</bpmn:incoming>
      <bpmn:incoming>ventas_avanzada_f1_4</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f1_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ventas_avanzada_p_dec" name="¿Hay stock?">
      <bpmn:incoming>ventas_avanzada_f1_1</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f1_2</bpmn:outgoing>
      <bpmn:outgoing>ventas_avanzada_f1_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="ventas_avanzada_p_emb" name="Embalar y etiquetar">
      <bpmn:incoming>ventas_avanzada_f1_2</bpmn:incoming>
      <bpmn:outgoing>ventas_avanzada_f1_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="ventas_avanzada_p_fin" name="Pedido listo">
