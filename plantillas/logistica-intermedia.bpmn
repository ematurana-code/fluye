      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_intermedia_fin" bpmnElement="logistica_intermedia_fin">
        <dc:Bounds x="1722" y="537" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_logistica_intermedia_f0_0" bpmnElement="logistica_intermedia_f0_0">
        <di:waypoint x="228" y="135" />
        <di:waypoint x="320" y="135" />
      </bpmndi:BPMNEdge>
