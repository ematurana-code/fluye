        <dc:Bounds x="110" y="60" width="1740" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_intermedia_carril_bod" bpmnElement="logistica_intermedia_carril_bod" isHorizontal="true">
        <dc:Bounds x="110" y="210" width="1740" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_intermedia_carril_des" bpmnElement="logistica_intermedia_carril_des" isHorizontal="true">
        <dc:Bounds x="110" y="480" width="1740" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_intermedia_ini" bpmnElement="logistica_intermedia_ini">
        <dc:Bounds x="192" y="117" width="36" height="36" />
