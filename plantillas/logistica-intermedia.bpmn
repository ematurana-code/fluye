      <bpmndi:BPMNShape id="DI_logistica_intermedia_emb" bpmnElement="logistica_intermedia_emb">
        <dc:Bounds x="1000" y="253" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_intermedia_gui" bpmnElement="logistica_intermedia_gui">
        <dc:Bounds x="1000" y="523" width="120" height="64" />
