<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="logistica_intermedia_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="logistica_intermedia_colab0">
    <bpmn:participant id="logistica_intermedia_pool_empresa" name="Empresa" processRef="logistica_intermedia_proceso_empresa" />
  </bpmn:collaboration>
  <bpmn:process id="logistica_intermedia_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="logistica_intermedia_carriles_empresa">
      <bpmn:lane id="logistica_intermedia_carril_ven" name="Ventas">
        <bpmn:flowNodeRef>logistica_intermedia_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_intermedia_val</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistica_intermedia_carril_bod" name="Bodega">
        <bpmn:flowNodeRef>logistica_intermedia_bus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_intermedia_sto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_intermedia_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_intermedia_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_intermedia_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_intermedia_emb</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistica_intermedia_carril_des" name="Despacho">
        <bpmn:flowNodeRef>logistica_intermedia_gui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_intermedia_jun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_intermedia_car</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_intermedia_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_intermedia_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="logistica_intermedia_ini" name="Llega un pedido">
      <bpmn:outgoing>logistica_intermedia_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="logistica_intermedia_val" name="Validar el pedido">
      <bpmn:incoming>logistica_intermedia_f0_0</bpmn:incoming>
      <bpmn:outgoing>logistica_intermedia_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="logistica_intermedia_bus" name="Buscar los productos">
      <bpmn:incoming>logistica_intermedia_f0_1</bpmn:incoming>
      <bpmn:incoming>logistica_intermedia_f0_6</bpmn:incoming>
      <bpmn:outgoing>logistica_intermedia_f0_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="logistica_intermedia_sto" name="¿Está todo en stock?">
      <bpmn:incoming>logistica_intermedia_f0_2</bpmn:incoming>
      <bpmn:outgoing>logistica_intermedia_f0_3</bpmn:outgoing>
      <bpmn:outgoing>logistica_intermedia_f0_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="logistica_intermedia_rep" name="Pedir reposición">
      <bpmn:incoming>logistica_intermedia_f0_4</bpmn:incoming>
      <bpmn:outgoing>logistica_intermedia_f0_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="logistica_intermedia_esp" name="Esperar la reposición (2 días)">
      <bpmn:incoming>logistica_intermedia_f0_5</bpmn:incoming>
      <bpmn:outgoing>logistica_intermedia_f0_6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="logistica_intermedia_esp_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="logistica_intermedia_par">
      <bpmn:incoming>logistica_intermedia_f0_3</bpmn:incoming>
      <bpmn:outgoing>logistica_intermedia_f0_7</bpmn:outgoing>
      <bpmn:outgoing>logistica_intermedia_f0_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="logistica_intermedia_emb" name="Embalar y etiquetar">
      <bpmn:incoming>logistica_intermedia_f0_7</bpmn:incoming>
      <bpmn:outgoing>logistica_intermedia_f0_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="logistica_intermedia_gui" name="Emitir la guía de despacho">
      <bpmn:incoming>logistica_intermedia_f0_8</bpmn:incoming>
      <bpmn:outgoing>logistica_intermedia_f0_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="logistica_intermedia_jun">
      <bpmn:incoming>logistica_intermedia_f0_9</bpmn:incoming>
      <bpmn:incoming>logistica_intermedia_f0_10</bpmn:incoming>
      <bpmn:outgoing>logistica_intermedia_f0_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="logistica_intermedia_car" name="Cargar el camión">
      <bpmn:incoming>logistica_intermedia_f0_11</bpmn:incoming>
      <bpmn:outgoing>logistica_intermedia_f0_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="logistica_intermedia_ent" name="Entregar al cliente">
      <bpmn:incoming>logistica_intermedia_f0_12</bpmn:incoming>
      <bpmn:outgoing>logistica_intermedia_f0_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="logistica_intermedia_fin" name="Pedido entregado">
      <bpmn:incoming>logistica_intermedia_f0_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="logistica_intermedia_f0_0" sourceRef="logistica_intermedia_ini" targetRef="logistica_intermedia_val" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_1" sourceRef="logistica_intermedia_val" targetRef="logistica_intermedia_bus" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_2" sourceRef="logistica_intermedia_bus" targetRef="logistica_intermedia_sto" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_3" name="Sí" sourceRef="logistica_intermedia_sto" targetRef="logistica_intermedia_par" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_4" name="No" sourceRef="logistica_intermedia_sto" targetRef="logistica_intermedia_rep" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_5" sourceRef="logistica_intermedia_rep" targetRef="logistica_intermedia_esp" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_6" sourceRef="logistica_intermedia_esp" targetRef="logistica_intermedia_bus" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_7" sourceRef="logistica_intermedia_par" targetRef="logistica_intermedia_emb" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_8" sourceRef="logistica_intermedia_par" targetRef="logistica_intermedia_gui" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_9" sourceRef="logistica_intermedia_emb" targetRef="logistica_intermedia_jun" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_10" sourceRef="logistica_intermedia_gui" targetRef="logistica_intermedia_jun" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_11" sourceRef="logistica_intermedia_jun" targetRef="logistica_intermedia_car" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_12" sourceRef="logistica_intermedia_car" targetRef="logistica_intermedia_ent" />
    <bpmn:sequenceFlow id="logistica_intermedia_f0_13" sourceRef="logistica_intermedia_ent" targetRef="logistica_intermedia_fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="logistica_intermedia_diagrama0" name="Despacho de pedidos">
    <bpmndi:BPMNPlane id="logistica_intermedia_plano0" bpmnElement="logistica_intermedia_colab0">
      <bpmndi:BPMNShape id="DI_logistica_intermedia_pool_empresa" bpmnElement="logistica_intermedia_pool_empresa" isHorizontal="true">
        <dc:Bounds x="80" y="60" width="1770" height="570" />
      </bpmndi:BPMNShape>
