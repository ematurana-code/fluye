<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluye="http://fluye.app/schema/1.0" id="logistica_avanzada_definiciones" targetNamespace="http://fluye.app/bpmn" exporter="Fluye" exporterVersion="0.1.0">
  <bpmn:collaboration id="logistica_avanzada_colab0">
    <bpmn:participant id="logistica_avanzada_pool_cliente" name="Cliente" processRef="logistica_avanzada_proceso_cliente" />
    <bpmn:participant id="logistica_avanzada_pool_empresa" name="Empresa" processRef="logistica_avanzada_proceso_empresa" />
    <bpmn:participant id="logistica_avanzada_pool_transporte" name="Transporte" processRef="logistica_avanzada_proceso_transporte" />
    <bpmn:messageFlow id="logistica_avanzada_m0_0" name="Solicitud" sourceRef="logistica_avanzada_c_sol" targetRef="logistica_avanzada_e_ini" />
    <bpmn:messageFlow id="logistica_avanzada_m0_1" name="Etiqueta" sourceRef="logistica_avanzada_e_eti" targetRef="logistica_avanzada_c_eti" />
    <bpmn:messageFlow id="logistica_avanzada_m0_2" name="Paquete" sourceRef="logistica_avanzada_c_ent" targetRef="logistica_avanzada_t_ini" />
    <bpmn:messageFlow id="logistica_avanzada_m0_3" name="Paquete" sourceRef="logistica_avanzada_t_ent" targetRef="logistica_avanzada_e_lle" />
    <bpmn:messageFlow id="logistica_avanzada_m0_4" name="Resultado" sourceRef="logistica_avanzada_e_avi" targetRef="logistica_avanzada_c_res" />
  </bpmn:collaboration>
  <bpmn:process id="logistica_avanzada_proceso_cliente" isExecutable="false">
    <bpmn:laneSet id="logistica_avanzada_carriles_cliente">
      <bpmn:lane id="logistica_avanzada_carril_cli" name="Cliente">
        <bpmn:flowNodeRef>logistica_avanzada_c_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_c_sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_c_eti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_c_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_c_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_c_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="logistica_avanzada_c_ini" name="Quiere devolver un producto">
      <bpmn:outgoing>logistica_avanzada_f0_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="logistica_avanzada_c_sol" name="Solicitar la devolución">
      <bpmn:incoming>logistica_avanzada_f0_0</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="logistica_avanzada_c_eti" name="Recibe la etiqueta de envío">
      <bpmn:incoming>logistica_avanzada_f0_1</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="logistica_avanzada_c_eti_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="logistica_avanzada_c_ent" name="Entregar el paquete al transporte">
      <bpmn:incoming>logistica_avanzada_f0_2</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="logistica_avanzada_c_res" name="Recibe el resultado">
      <bpmn:incoming>logistica_avanzada_f0_3</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="logistica_avanzada_c_res_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="logistica_avanzada_c_fin" name="Devolución cerrada">
      <bpmn:incoming>logistica_avanzada_f0_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="logistica_avanzada_f0_0" sourceRef="logistica_avanzada_c_ini" targetRef="logistica_avanzada_c_sol" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_1" sourceRef="logistica_avanzada_c_sol" targetRef="logistica_avanzada_c_eti" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_2" sourceRef="logistica_avanzada_c_eti" targetRef="logistica_avanzada_c_ent" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_3" sourceRef="logistica_avanzada_c_ent" targetRef="logistica_avanzada_c_res" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_4" sourceRef="logistica_avanzada_c_res" targetRef="logistica_avanzada_c_fin" />
  </bpmn:process>
  <bpmn:process id="logistica_avanzada_proceso_empresa" isExecutable="false">
    <bpmn:laneSet id="logistica_avanzada_carriles_empresa">
      <bpmn:lane id="logistica_avanzada_carril_ate" name="Atención al cliente">
        <bpmn:flowNodeRef>logistica_avanzada_e_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_e_eti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_e_nc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_e_uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_e_avi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistica_avanzada_carril_bod" name="Bodega">
        <bpmn:flowNodeRef>logistica_avanzada_e_lle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_e_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_e_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_e_dev</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="logistica_avanzada_e_ini" name="Llega la solicitud">
      <bpmn:outgoing>logistica_avanzada_f0_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="logistica_avanzada_e_ini_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="logistica_avanzada_e_eti" name="Aprobar y enviar la etiqueta">
      <bpmn:incoming>logistica_avanzada_f0_5</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="logistica_avanzada_e_lle" name="Llega el paquete">
      <bpmn:incoming>logistica_avanzada_f0_6</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="logistica_avanzada_e_lle_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="logistica_avanzada_e_rev" name="Revisar el producto devuelto">
      <bpmn:documentation>El detalle está en la pestaña "Revisión".</bpmn:documentation>
      <bpmn:incoming>logistica_avanzada_f0_7</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_8</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="logistica_avanzada_e_dec" name="¿Procede la devolución?">
      <bpmn:incoming>logistica_avanzada_f0_8</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_9</bpmn:outgoing>
      <bpmn:outgoing>logistica_avanzada_f0_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="logistica_avanzada_e_nc" name="Emitir la nota de crédito">
      <bpmn:incoming>logistica_avanzada_f0_9</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="logistica_avanzada_e_dev" name="Preparar el reenvío al cliente">
      <bpmn:incoming>logistica_avanzada_f0_10</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="logistica_avanzada_e_uni">
      <bpmn:incoming>logistica_avanzada_f0_11</bpmn:incoming>
      <bpmn:incoming>logistica_avanzada_f0_12</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="logistica_avanzada_e_avi" name="Avisar el resultado al cliente">
      <bpmn:incoming>logistica_avanzada_f0_13</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="logistica_avanzada_e_avi_def" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="logistica_avanzada_e_fin" name="Devolución resuelta">
      <bpmn:incoming>logistica_avanzada_f0_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="logistica_avanzada_f0_5" sourceRef="logistica_avanzada_e_ini" targetRef="logistica_avanzada_e_eti" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_6" sourceRef="logistica_avanzada_e_eti" targetRef="logistica_avanzada_e_lle" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_7" sourceRef="logistica_avanzada_e_lle" targetRef="logistica_avanzada_e_rev" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_8" sourceRef="logistica_avanzada_e_rev" targetRef="logistica_avanzada_e_dec" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_9" name="Sí" sourceRef="logistica_avanzada_e_dec" targetRef="logistica_avanzada_e_nc" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_10" name="No" sourceRef="logistica_avanzada_e_dec" targetRef="logistica_avanzada_e_dev" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_11" sourceRef="logistica_avanzada_e_nc" targetRef="logistica_avanzada_e_uni" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_12" sourceRef="logistica_avanzada_e_dev" targetRef="logistica_avanzada_e_uni" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_13" sourceRef="logistica_avanzada_e_uni" targetRef="logistica_avanzada_e_avi" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_14" sourceRef="logistica_avanzada_e_avi" targetRef="logistica_avanzada_e_fin" />
  </bpmn:process>
  <bpmn:process id="logistica_avanzada_proceso_transporte" isExecutable="false">
    <bpmn:laneSet id="logistica_avanzada_carriles_transporte">
      <bpmn:lane id="logistica_avanzada_carril_tra" name="Transporte">
        <bpmn:flowNodeRef>logistica_avanzada_t_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_t_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_t_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_t_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="logistica_avanzada_t_ini" name="Recibe el paquete">
      <bpmn:outgoing>logistica_avanzada_f0_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="logistica_avanzada_t_ini_def" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="logistica_avanzada_t_esp" name="Esperar la ruta de retiro (24 h)">
      <bpmn:incoming>logistica_avanzada_f0_15</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="logistica_avanzada_t_esp_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="logistica_avanzada_t_ent" name="Entregar en la bodega">
      <bpmn:incoming>logistica_avanzada_f0_16</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f0_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="logistica_avanzada_t_fin" name="Paquete entregado">
      <bpmn:incoming>logistica_avanzada_f0_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="logistica_avanzada_f0_15" sourceRef="logistica_avanzada_t_ini" targetRef="logistica_avanzada_t_esp" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_16" sourceRef="logistica_avanzada_t_esp" targetRef="logistica_avanzada_t_ent" />
    <bpmn:sequenceFlow id="logistica_avanzada_f0_17" sourceRef="logistica_avanzada_t_ent" targetRef="logistica_avanzada_t_fin" />
  </bpmn:process>
  <bpmn:collaboration id="logistica_avanzada_colab1">
    <bpmn:participant id="logistica_avanzada_pool_revision" name="Revisión del producto devuelto" processRef="logistica_avanzada_proceso_revision" />
  </bpmn:collaboration>
  <bpmn:process id="logistica_avanzada_proceso_revision" isExecutable="false">
    <bpmn:laneSet id="logistica_avanzada_carriles_revision">
      <bpmn:lane id="logistica_avanzada_carril_r_bod" name="Bodega">
        <bpmn:flowNodeRef>logistica_avanzada_r_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_r_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_r_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_r_fot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_r_jun</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistica_avanzada_carril_r_cal" name="Calidad">
        <bpmn:flowNodeRef>logistica_avanzada_r_uso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_r_inf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logistica_avanzada_r_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="logistica_avanzada_r_ini" name="Llega el producto">
      <bpmn:outgoing>logistica_avanzada_f1_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="logistica_avanzada_r_ins" name="Inspeccionar el estado">
      <bpmn:incoming>logistica_avanzada_f1_0</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f1_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="logistica_avanzada_r_par">
      <bpmn:incoming>logistica_avanzada_f1_1</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f1_2</bpmn:outgoing>
      <bpmn:outgoing>logistica_avanzada_f1_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="logistica_avanzada_r_fot" name="Registrar con fotos">
      <bpmn:incoming>logistica_avanzada_f1_2</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f1_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="logistica_avanzada_r_uso" name="Revisar si tiene uso o daño">
      <bpmn:incoming>logistica_avanzada_f1_3</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f1_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="logistica_avanzada_r_jun">
      <bpmn:incoming>logistica_avanzada_f1_4</bpmn:incoming>
      <bpmn:incoming>logistica_avanzada_f1_5</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f1_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="logistica_avanzada_r_inf" name="Emitir el informe de revisión">
      <bpmn:incoming>logistica_avanzada_f1_6</bpmn:incoming>
      <bpmn:outgoing>logistica_avanzada_f1_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="logistica_avanzada_r_fin" name="Revisión terminada">
      <bpmn:incoming>logistica_avanzada_f1_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="logistica_avanzada_f1_0" sourceRef="logistica_avanzada_r_ini" targetRef="logistica_avanzada_r_ins" />
    <bpmn:sequenceFlow id="logistica_avanzada_f1_1" sourceRef="logistica_avanzada_r_ins" targetRef="logistica_avanzada_r_par" />
    <bpmn:sequenceFlow id="logistica_avanzada_f1_2" sourceRef="logistica_avanzada_r_par" targetRef="logistica_avanzada_r_fot" />
    <bpmn:sequenceFlow id="logistica_avanzada_f1_3" sourceRef="logistica_avanzada_r_par" targetRef="logistica_avanzada_r_uso" />
    <bpmn:sequenceFlow id="logistica_avanzada_f1_4" sourceRef="logistica_avanzada_r_fot" targetRef="logistica_avanzada_r_jun" />
    <bpmn:sequenceFlow id="logistica_avanzada_f1_5" sourceRef="logistica_avanzada_r_uso" targetRef="logistica_avanzada_r_jun" />
    <bpmn:sequenceFlow id="logistica_avanzada_f1_6" sourceRef="logistica_avanzada_r_jun" targetRef="logistica_avanzada_r_inf" />
    <bpmn:sequenceFlow id="logistica_avanzada_f1_7" sourceRef="logistica_avanzada_r_inf" targetRef="logistica_avanzada_r_fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="logistica_avanzada_diagrama0" name="Devolución">
    <bpmndi:BPMNPlane id="logistica_avanzada_plano0" bpmnElement="logistica_avanzada_colab0">
      <bpmndi:BPMNShape id="DI_logistica_avanzada_pool_cliente" bpmnElement="logistica_avanzada_pool_cliente" isHorizontal="true">
        <dc:Bounds x="80" y="60" width="2280" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_pool_empresa" bpmnElement="logistica_avanzada_pool_empresa" isHorizontal="true">
        <dc:Bounds x="80" y="300" width="2280" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_pool_transporte" bpmnElement="logistica_avanzada_pool_transporte" isHorizontal="true">
        <dc:Bounds x="80" y="810" width="2280" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_carril_cli" bpmnElement="logistica_avanzada_carril_cli" isHorizontal="true">
        <dc:Bounds x="110" y="60" width="2250" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_carril_ate" bpmnElement="logistica_avanzada_carril_ate" isHorizontal="true">
        <dc:Bounds x="110" y="300" width="2250" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_carril_bod" bpmnElement="logistica_avanzada_carril_bod" isHorizontal="true">
        <dc:Bounds x="110" y="450" width="2250" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_carril_tra" bpmnElement="logistica_avanzada_carril_tra" isHorizontal="true">
        <dc:Bounds x="110" y="810" width="2250" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_c_ini" bpmnElement="logistica_avanzada_c_ini">
        <dc:Bounds x="192" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_c_sol" bpmnElement="logistica_avanzada_c_sol">
        <dc:Bounds x="320" y="103" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_c_eti" bpmnElement="logistica_avanzada_c_eti">
        <dc:Bounds x="702" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_c_ent" bpmnElement="logistica_avanzada_c_ent">
        <dc:Bounds x="830" y="103" width="120" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_c_res" bpmnElement="logistica_avanzada_c_res">
        <dc:Bounds x="2062" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_c_fin" bpmnElement="logistica_avanzada_c_fin">
        <dc:Bounds x="2232" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_logistica_avanzada_e_ini" bpmnElement="logistica_avanzada_e_ini">
        <dc:Bounds x="362" y="357" width="36" height="36" />
