<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_ciclo" targetNamespace="http://fluye/pruebas">
  <bpmn:process id="P_ciclo" isExecutable="false">
    <bpmn:startEvent id="Inicio" name="Llega una solicitud"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Revisar" name="Revisar la solicitud"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Ok" name="¿Está completa?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="Fin" name="Aprobada"><bpmn:incoming>F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Pedir" name="Pedir lo que falta"><bpmn:incoming>F4</bpmn:incoming><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Esperar" name="Esperar respuesta"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="Revisar"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Revisar" targetRef="Ok"/>
    <bpmn:sequenceFlow id="F3" name="Sí" sourceRef="Ok" targetRef="Fin"/>
    <bpmn:sequenceFlow id="F4" name="No" sourceRef="Ok" targetRef="Pedir"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Pedir" targetRef="Esperar"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Esperar" targetRef="Pedir"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_ciclo"><bpmndi:BPMNPlane id="Pl_ciclo" bpmnElement="P_ciclo">
    <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio"><dc:Bounds x="100" y="122" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Revisar_di" bpmnElement="Revisar"><dc:Bounds x="190" y="100" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Ok_di" bpmnElement="Ok" isMarkerVisible="true"><dc:Bounds x="345" y="115" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Fin_di" bpmnElement="Fin"><dc:Bounds x="460" y="122" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Pedir_di" bpmnElement="Pedir"><dc:Bounds x="320" y="250" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Esperar_di" bpmnElement="Esperar"><dc:Bounds x="500" y="250" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="136" y="140"/><di:waypoint x="190" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="290" y="140"/><di:waypoint x="345" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="395" y="140"/><di:waypoint x="460" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="370" y="165"/><di:waypoint x="370" y="250"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="420" y="280"/><di:waypoint x="500" y="280"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="550" y="330"/><di:waypoint x="550" y="370"/><di:waypoint x="370" y="370"/><di:waypoint x="370" y="330"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
