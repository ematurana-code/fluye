    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_4jca10g3qi" name="Quiere ingresar">
      <bpmn:documentation>El usuario abre la página y quiere entrar con su cuenta.</bpmn:documentation>
      <bpmn:outgoing>SequenceFlow_4jcav0wodt</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_4jcad0h92c" name="Mostrar formulario de login">
      <bpmn:documentation>La web muestra los campos de usuario y contraseña.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_4jcav0wodt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcb10xbdl</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_4jcaf0ipmd" name="Ingresar usuario y contraseña">
      <bpmn:documentation>El usuario escribe sus datos y presiona Ingresar.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_4jcb10xbdl</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_4jcbm1a2q2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcb20yawk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_4jcah0jsir" name="Validar credenciales">
      <bpmn:documentation>La web compara los datos con los registrados.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_4jcb20yawk</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcb40zow5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_4jcai0kf9u" name="¿Credenciales correctas?">
      <bpmn:incoming>SequenceFlow_4jcb40zow5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcb510g8o</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4jcb711ttg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ParallelGateway_4jcaj0lr1o">
      <bpmn:incoming>SequenceFlow_4jcb510g8o</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcbb12eci</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4jcbd13nsm</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask_4jcak0mrcj" name="Crear sesión">
      <bpmn:documentation>Se genera la sesión segura del usuario.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_4jcbb12eci</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcbe14lp4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_4jcam0nmgn" name="Registrar acceso en bitácora">
      <bpmn:documentation>Se guarda fecha, hora e IP del ingreso.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_4jcbd13nsm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcbg15hgj</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway_4jcan0okcs">
      <bpmn:incoming>SequenceFlow_4jcbe14lp4</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_4jcbg15hgj</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcbh16hda</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask_4jcao0p9y9" name="Ver panel principal">
      <bpmn:documentation>El usuario ya está dentro de la página.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_4jcbh16hda</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcbi17gy3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_4jcaq0q4uc" name="Sesión iniciada">
      <bpmn:incoming>SequenceFlow_4jcbi17gy3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask_4jcar0r4ab" name="Sumar intento fallido">
      <bpmn:documentation>Se cuenta el intento incorrecto.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_4jcb711ttg</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcbj18wf4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_4jcas0s7mm" name="¿Superó 3 intentos?">
      <bpmn:incoming>SequenceFlow_4jcbj18wf4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcbk19t0y</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4jcbm1bgrl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_4jcat0tr6c" name="Mostrar mensaje de error">
      <bpmn:documentation>Avisa que el usuario o la contraseña no son correctos.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_4jcbk19t0y</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcbm1a2q2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_4jcat0uu62" name="Bloquear cuenta 15 minutos">
      <bpmn:documentation>Protege la cuenta ante intentos repetidos.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_4jcbm1bgrl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4jcbn1c3au</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_4jcau0v5z9" name="Cuenta bloqueada">
      <bpmn:incoming>SequenceFlow_4jcbn1c3au</bpmn:incoming>
    </bpmn:endEvent>
